---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/site.config";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
};

const {
  title = SITE.title,
  description = SITE.description,
  canonical,
  image = "/og/default.png",
  type = "website"
} = Astro.props;

const pageTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, SITE.domain).toString();
const imageUrl = new URL(image, SITE.domain).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} Writing`} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      (() => {
        const storageKey = "didac-crst-theme";
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        const normalizeTheme = (value) =>
          value === "light" || value === "dark" || value === "system" ? value : "system";

        const getPreference = () => normalizeTheme(localStorage.getItem(storageKey));
        const getEffectiveTheme = (preference) =>
          preference === "system" ? (media.matches ? "dark" : "light") : preference;

        const applyTheme = (preference, persist = false) => {
          const theme = normalizeTheme(preference);

          if (persist) {
            localStorage.setItem(storageKey, theme);
          }

          if (theme === "system") {
            root.removeAttribute("data-theme");
          } else {
            root.setAttribute("data-theme", theme);
          }

          root.setAttribute("data-theme-preference", theme);
          root.setAttribute("data-theme-effective", getEffectiveTheme(theme));
          window.dispatchEvent(
            new CustomEvent("didac-theme-change", {
              detail: {
                preference: theme,
                effective: getEffectiveTheme(theme)
              }
            })
          );
        };

        const savedTheme = getPreference();
        applyTheme(savedTheme);

        media.addEventListener("change", () => {
          if (getPreference() === "system") {
            applyTheme("system");
          }
        });

        window.DidacTheme = {
          getPreference,
          setPreference: (preference) => applyTheme(preference, true)
        };
      })();
    </script>
  </head>
  <body>
    <div class="site-shell">
      <Header />
      <main class="site-main">
        <slot />
      </main>
      <Footer />
    </div>
  </body>
</html>
