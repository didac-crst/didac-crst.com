---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { SITE } from "@/site.config";
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  canonical?: string;
  image?: string;
  type?: "website" | "article";
};

const {
  title = SITE.title,
  description = SITE.description,
  canonical,
  image = "/og/default.png",
  type = "website"
} = Astro.props;

const pageTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, SITE.domain).toString();
const imageUrl = new URL(image, SITE.domain).toString();
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} Writing`} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <ClientRouter />
    <script is:inline>
      (() => {
        const storageKey = "didac-crst-theme";
        const root = document.documentElement;
        const media = window.matchMedia("(prefers-color-scheme: dark)");

        const normalizeTheme = (value) =>
          value === "light" || value === "dark" || value === "system" ? value : "system";

        const getPreference = () => normalizeTheme(localStorage.getItem(storageKey));
        const getEffectiveTheme = (preference) =>
          preference === "system" ? (media.matches ? "dark" : "light") : preference;

        const applyTheme = (preference, persist = false) => {
          const theme = normalizeTheme(preference);

          if (persist) {
            localStorage.setItem(storageKey, theme);
          }

          if (theme === "system") {
            root.removeAttribute("data-theme");
          } else {
            root.setAttribute("data-theme", theme);
          }

          root.setAttribute("data-theme-preference", theme);
          root.setAttribute("data-theme-effective", getEffectiveTheme(theme));
          window.dispatchEvent(
            new CustomEvent("didac-theme-change", {
              detail: {
                preference: theme,
                effective: getEffectiveTheme(theme)
              }
            })
          );
        };

        const savedTheme = getPreference();
        applyTheme(savedTheme);

        media.addEventListener("change", () => {
          if (getPreference() === "system") {
            applyTheme("system");
          }
        });

        window.DidacTheme = {
          getPreference,
          setPreference: (preference) => applyTheme(preference, true)
        };
      })();
    </script>
  </head>
  <body>
    <div class="site-shell">
      <Header transition:persist />
      <main class="site-main">
        <slot />
      </main>
      <Footer />
    </div>
    <script is:inline>
      (() => {
        if (window.DidacMotion) return;

        const syncActiveNavigation = () => {
          const currentPath = window.location.pathname;

          document.querySelectorAll(".primary-nav a").forEach((link) => {
            const linkPath = new URL(link.getAttribute("href") || "/", window.location.origin).pathname;

            if (linkPath === currentPath) {
              link.setAttribute("aria-current", "page");
            } else {
              link.removeAttribute("aria-current");
            }
          });
        };

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");
        let observer;

        const decorateArticleContent = () => {
          document
            .querySelectorAll(".article-content figure, .article-content table, .article-content pre, .article-content blockquote")
            .forEach((element) => {
              element.setAttribute("data-motion-reveal", "");
            });
        };

        const revealNow = () => {
          document.querySelectorAll("[data-motion-reveal]").forEach((element) => {
            element.classList.add("is-visible");
          });
        };

        const init = () => {
          syncActiveNavigation();
          decorateArticleContent();
          document.documentElement.classList.add("motion-ready");

          if (observer) {
            observer.disconnect();
          }

          if (reduceMotion.matches) {
            revealNow();
            return;
          }

          observer = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  observer.unobserve(entry.target);
                }
              });
            },
            {
              rootMargin: "0px 0px -10% 0px",
              threshold: 0.16
            }
          );

          document.querySelectorAll("[data-motion-reveal]:not(.is-visible)").forEach((element) => {
            observer.observe(element);
          });
        };

        window.DidacMotion = { init };
        document.addEventListener("astro:after-swap", syncActiveNavigation);
        document.addEventListener("astro:page-load", init);
        init();
      })();
    </script>
  </body>
</html>
