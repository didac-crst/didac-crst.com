---
import Header from "@/components/Header.astro";
import Footer from "@/components/Footer.astro";
import { ensureMetaDescription } from "@/lib/meta";
import { SITE } from "@/site.config";
import { ClientRouter } from "astro:transitions";
import "@/styles/global.css";

type Props = {
  title?: string;
  description?: string;
  descriptionFallback?: string;
  canonical?: string;
  image?: string;
  imageWidth?: number;
  imageHeight?: number;
  author?: string;
  authorUrl?: string;
  publishedTime?: string;
  modifiedTime?: string;
  type?: "website" | "article";
};

const {
  title = SITE.title,
  description = SITE.description,
  descriptionFallback,
  canonical,
  image = SITE.defaultOgImage,
  imageWidth = 1200,
  imageHeight = 630,
  author = SITE.name,
  authorUrl = SITE.domain,
  publishedTime,
  modifiedTime,
  type = "website"
} = Astro.props;

const pageTitle = title === SITE.title ? title : `${title} | ${SITE.title}`;
const metaDescription = ensureMetaDescription(description, descriptionFallback);
const canonicalUrl = new URL(canonical ?? Astro.url.pathname, SITE.domain).toString();
const imageUrl = new URL(image, SITE.domain).toString();
---

<!doctype html>
<html lang="en" data-theme="dark">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="generator" content={Astro.generator} />
    <title>{pageTitle}</title>
    <meta name="description" content={metaDescription} />
    <meta name="author" content={author} />
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" href={SITE.faviconIco} sizes="any" />
    <link rel="icon" type="image/png" sizes="16x16" href={SITE.favicon16} />
    <link rel="icon" type="image/png" sizes="32x32" href={SITE.favicon32} />
    <link rel="icon" type="image/png" sizes="48x48" href={SITE.favicon48} />
    <link rel="apple-touch-icon" sizes="180x180" href={SITE.appleTouchIcon} />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.title} Writing`} href="/rss.xml" />
    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={metaDescription} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:width" content={String(imageWidth)} />
    <meta property="og:image:height" content={String(imageHeight)} />
    {type === "article" && <meta property="article:author" content={authorUrl} />}
    {type === "article" && publishedTime && <meta property="article:published_time" content={publishedTime} />}
    {type === "article" && modifiedTime && <meta property="article:modified_time" content={modifiedTime} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={metaDescription} />
    <meta name="twitter:image" content={imageUrl} />
    <ClientRouter />
    <script is:inline>
      (() => {
        const storageKey = "didac-crst-theme";
        let sessionPreference = "dark";
        let storageUnavailable = false;

        const normalizeTheme = (value) => {
          if (value === "light" || value === "dark") return value;
          // Former "system" (and anything unknown) → dark default
          return "dark";
        };

        const getPreference = () => {
          if (storageUnavailable) {
            return sessionPreference;
          }

          try {
            sessionPreference = normalizeTheme(localStorage.getItem(storageKey));
            return sessionPreference;
          } catch {
            storageUnavailable = true;
            return sessionPreference;
          }
        };

        const applyThemePreference = (preference = getPreference(), persist = false) => {
          const theme = normalizeTheme(preference);
          const root = document.documentElement;
          sessionPreference = theme;

          if (persist) {
            try {
              localStorage.setItem(storageKey, theme);
            } catch {
              storageUnavailable = true;
              // Ignore storage errors; the current document can still reflect the choice.
            }
          }

          root.setAttribute("data-theme", theme);
          root.setAttribute("data-theme-preference", theme);
          root.setAttribute("data-theme-effective", theme);
          window.dispatchEvent(
            new CustomEvent("didac-theme-change", {
              detail: {
                preference: theme,
                effective: theme
              }
            })
          );
        };

        applyThemePreference();

        if (!window.DidacTheme) {
          document.addEventListener("astro:after-swap", () => {
            applyThemePreference();
          });

          window.DidacTheme = {
            getPreference,
            applyThemePreference,
            setPreference: (preference) => applyThemePreference(preference, true)
          };
        } else {
          window.DidacTheme.applyThemePreference = applyThemePreference;
          window.DidacTheme.getPreference = getPreference;
          window.DidacTheme.setPreference = (preference) => applyThemePreference(preference, true);
        }
      })();
    </script>
    <script is:inline>
      (() => {
        const storageKey = "didac-crst-reader-size-v2";
        const sizes = new Set(["xs", "s", "m", "l", "xl"]);
        let sessionSize = "s";
        let storageUnavailable = false;

        const normalizeSize = (value) => (sizes.has(value) ? value : "s");

        const getPreference = () => {
          if (storageUnavailable) {
            return sessionSize;
          }

          try {
            sessionSize = normalizeSize(localStorage.getItem(storageKey));
            return sessionSize;
          } catch {
            storageUnavailable = true;
            return sessionSize;
          }
        };

        const applyReaderSize = (preference = getPreference(), persist = false) => {
          const size = normalizeSize(preference);
          const root = document.documentElement;
          sessionSize = size;

          if (persist) {
            try {
              localStorage.setItem(storageKey, size);
            } catch {
              storageUnavailable = true;
            }
          }

          root.setAttribute("data-reader-size", size);
          window.dispatchEvent(
            new CustomEvent("didac-reader-size-change", {
              detail: { size }
            })
          );
        };

        applyReaderSize();

        if (!window.DidacReaderSize) {
          document.addEventListener("astro:after-swap", () => {
            applyReaderSize();
          });

          window.DidacReaderSize = {
            getPreference,
            applyReaderSize,
            setPreference: (preference) => applyReaderSize(preference, true)
          };
        } else {
          window.DidacReaderSize.applyReaderSize = applyReaderSize;
          window.DidacReaderSize.getPreference = getPreference;
          window.DidacReaderSize.setPreference = (preference) => applyReaderSize(preference, true);
        }
      })();
    </script>
  </head>
  <body>
    <div class="site-shell">
      <Header />
      <main class="site-main">
        <slot />
      </main>
      <Footer />
    </div>
    <script is:inline>
      (() => {
        const getElement = (target) => (target instanceof Element ? target : target?.parentElement);

        const syncActiveNavigation = () => {
          const currentPath = window.location.pathname;

          document.querySelectorAll(".primary-nav a, .mobile-nav a").forEach((link) => {
            const linkPath = new URL(link.getAttribute("href") || "/", window.location.origin).pathname;

            if (linkPath === currentPath) {
              link.setAttribute("aria-current", "page");
            } else {
              link.removeAttribute("aria-current");
            }
          });
        };

        const renderThemeControl = (control, theme) => {
          const trigger = control.querySelector("[data-theme-trigger]");
          const label = control.querySelector("[data-theme-label]");
          const buttons = Array.from(control.querySelectorAll("[data-theme-choice]"));

          control.dataset.themePreference = theme;

          if (label) {
            label.textContent = theme.charAt(0).toUpperCase() + theme.slice(1);
            trigger?.setAttribute("aria-label", `Theme: ${label.textContent}`);
          }

          buttons.forEach((button) => {
            button.setAttribute("aria-checked", button.dataset.themeChoice === theme ? "true" : "false");
          });
        };

        const renderThemeControls = () => {
          const preference = window.DidacTheme?.getPreference?.() || "dark";
          document.querySelectorAll("[data-theme-control]").forEach((control) => {
            renderThemeControl(control, preference);
          });
        };

        const renderReaderControl = (control, size) => {
          const trigger = control.querySelector("[data-reader-trigger]");
          const label = control.querySelector("[data-reader-label]");
          const buttons = Array.from(control.querySelectorAll("[data-reader-choice]"));
          const labelText = String(size || "s").toUpperCase();

          control.dataset.readerSize = size;

          if (label) {
            label.textContent = labelText;
          }

          trigger?.setAttribute("aria-label", `Reading text size: ${labelText}`);

          buttons.forEach((button) => {
            button.setAttribute("aria-checked", button.dataset.readerChoice === size ? "true" : "false");
          });
        };

        const renderReaderControls = () => {
          const preference = window.DidacReaderSize?.getPreference?.() || "s";
          document.querySelectorAll("[data-reader-control]").forEach((control) => {
            renderReaderControl(control, preference);
          });
        };

        const closeThemeMenu = (control, focusTrigger = false) => {
          const trigger = control?.querySelector("[data-theme-trigger]");
          const menu = control?.querySelector("[data-theme-menu]");
          if (!trigger || !menu) return;

          trigger.setAttribute("aria-expanded", "false");
          menu.hidden = true;

          if (focusTrigger) {
            trigger.focus();
          }
        };

        const closeAllThemeMenus = () => {
          document.querySelectorAll("[data-theme-control]").forEach((control) => closeThemeMenu(control));
        };

        const closeReaderMenu = (control, focusTrigger = false) => {
          const trigger = control?.querySelector("[data-reader-trigger]");
          const menu = control?.querySelector("[data-reader-menu]");
          if (!trigger || !menu) return;

          trigger.setAttribute("aria-expanded", "false");
          menu.hidden = true;

          if (focusTrigger) {
            trigger.focus();
          }
        };

        const closeAllReaderMenus = () => {
          document.querySelectorAll("[data-reader-control]").forEach((control) => closeReaderMenu(control));
        };

        const closeAllPreferenceMenus = () => {
          closeAllThemeMenus();
          closeAllReaderMenus();
        };

        const openThemeMenu = (control) => {
          const trigger = control.querySelector("[data-theme-trigger]");
          const menu = control.querySelector("[data-theme-menu]");
          const checkedButton =
            control.querySelector('[data-theme-choice][aria-checked="true"]') ||
            control.querySelector("[data-theme-choice]");
          if (!trigger || !menu) return;

          closeAllPreferenceMenus();
          trigger.setAttribute("aria-expanded", "true");
          menu.hidden = false;
          checkedButton?.focus();
        };

        const toggleThemeMenu = (control) => {
          const trigger = control.querySelector("[data-theme-trigger]");
          const isOpen = trigger?.getAttribute("aria-expanded") === "true";
          if (isOpen) {
            closeThemeMenu(control);
          } else {
            openThemeMenu(control);
          }
        };

        const openReaderMenu = (control) => {
          const trigger = control.querySelector("[data-reader-trigger]");
          const menu = control.querySelector("[data-reader-menu]");
          const checkedButton =
            control.querySelector('[data-reader-choice][aria-checked="true"]') ||
            control.querySelector("[data-reader-choice]");
          if (!trigger || !menu) return;

          closeAllPreferenceMenus();
          trigger.setAttribute("aria-expanded", "true");
          menu.hidden = false;
          checkedButton?.focus();
        };

        const toggleReaderMenu = (control) => {
          const trigger = control.querySelector("[data-reader-trigger]");
          const isOpen = trigger?.getAttribute("aria-expanded") === "true";
          if (isOpen) {
            closeReaderMenu(control);
          } else {
            openReaderMenu(control);
          }
        };

        const setMobileMenuOpen = (open) => {
          const trigger = document.querySelector("[data-mobile-menu-trigger]");
          const menu = document.querySelector("[data-mobile-menu]");
          if (!trigger || !menu) return;

          trigger.setAttribute("aria-expanded", String(open));
          menu.hidden = !open;
        };

        const closeMobileMenu = () => setMobileMenuOpen(false);

        const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

        const decorateArticleContent = () => {
          document
            .querySelectorAll(".article-content figure, .article-content table, .article-content pre, .article-content blockquote")
            .forEach((element) => {
              element.setAttribute("data-motion-reveal", "");
            });
        };

        const revealNow = () => {
          document.querySelectorAll("[data-motion-reveal]").forEach((element) => {
            element.classList.add("is-visible");
          });
        };

        const initPageInteractions = () => {
          syncActiveNavigation();
          renderThemeControls();
          renderReaderControls();
          closeAllPreferenceMenus();
          closeMobileMenu();
          decorateArticleContent();
          document.documentElement.classList.add("motion-ready");

          if (window.DidacUI?.motionObserver) {
            window.DidacUI.motionObserver.disconnect();
          }

          if (reduceMotion.matches) {
            revealNow();
            return;
          }

          window.DidacUI.motionObserver = new IntersectionObserver(
            (entries) => {
              entries.forEach((entry) => {
                if (entry.isIntersecting) {
                  entry.target.classList.add("is-visible");
                  window.DidacUI.motionObserver?.unobserve(entry.target);
                }
              });
            },
            {
              rootMargin: "0px 0px -10% 0px",
              threshold: 0.16
            }
          );

          document.querySelectorAll("[data-motion-reveal]:not(.is-visible)").forEach((element) => {
            window.DidacUI.motionObserver?.observe(element);
          });
        };

        if (!window.DidacUI) {
          window.DidacUI = {
            motionObserver: null,
            initPageInteractions
          };

          document.addEventListener("click", (event) => {
            const target = getElement(event.target);
            if (!target) return;

            const themeChoice = target.closest("[data-theme-choice]");
            if (themeChoice) {
              const control = themeChoice.closest("[data-theme-control]");
              const theme = themeChoice.dataset.themeChoice || "dark";
              window.DidacTheme?.setPreference?.(theme);
              renderThemeControls();
              closeThemeMenu(control, true);
              return;
            }

            const readerChoice = target.closest("[data-reader-choice]");
            if (readerChoice) {
              const control = readerChoice.closest("[data-reader-control]");
              const size = readerChoice.dataset.readerChoice || "s";
              window.DidacReaderSize?.setPreference?.(size);
              renderReaderControls();
              closeReaderMenu(control, true);
              return;
            }

            const themeTrigger = target.closest("[data-theme-trigger]");
            if (themeTrigger) {
              const control = themeTrigger.closest("[data-theme-control]");
              if (control) {
                toggleThemeMenu(control);
              }
              return;
            }

            const readerTrigger = target.closest("[data-reader-trigger]");
            if (readerTrigger) {
              const control = readerTrigger.closest("[data-reader-control]");
              if (control) {
                toggleReaderMenu(control);
              }
              return;
            }

            const mobileTrigger = target.closest("[data-mobile-menu-trigger]");
            if (mobileTrigger) {
              setMobileMenuOpen(mobileTrigger.getAttribute("aria-expanded") !== "true");
              return;
            }

            if (target.closest(".mobile-nav a")) {
              closeMobileMenu();
              return;
            }

            if (!target.closest("[data-theme-control]") && !target.closest("[data-reader-control]")) {
              closeAllPreferenceMenus();
            }
          });

          document.addEventListener("keydown", (event) => {
            const target = getElement(event.target);

            if (event.key === "Escape") {
              const openThemeControl = document.querySelector('[data-theme-trigger][aria-expanded="true"]')?.closest("[data-theme-control]");
              if (openThemeControl) {
                event.preventDefault();
                closeThemeMenu(openThemeControl, true);
                return;
              }

              const openReaderControl = document.querySelector('[data-reader-trigger][aria-expanded="true"]')?.closest("[data-reader-control]");
              if (openReaderControl) {
                event.preventDefault();
                closeReaderMenu(openReaderControl, true);
                return;
              }

              const mobileTrigger = document.querySelector("[data-mobile-menu-trigger]");
              if (mobileTrigger?.getAttribute("aria-expanded") === "true") {
                event.preventDefault();
                closeMobileMenu();
                mobileTrigger.focus();
              }
            }

            const activeThemeChoice = target?.closest("[data-theme-choice]");
            if (activeThemeChoice) {
              const control = activeThemeChoice.closest("[data-theme-control]");
              const buttons = Array.from(control?.querySelectorAll("[data-theme-choice]") || []);
              const currentIndex = buttons.indexOf(activeThemeChoice);

              if (event.key === "ArrowDown" || event.key === "ArrowUp") {
                event.preventDefault();
                const offset = event.key === "ArrowDown" ? 1 : -1;
                const nextIndex = (currentIndex + offset + buttons.length) % buttons.length;
                buttons[nextIndex]?.focus();
              }

              if (event.key === "Home") {
                event.preventDefault();
                buttons[0]?.focus();
              }

              if (event.key === "End") {
                event.preventDefault();
                buttons[buttons.length - 1]?.focus();
              }
              return;
            }

            const activeReaderChoice = target?.closest("[data-reader-choice]");
            if (!activeReaderChoice) return;

            const control = activeReaderChoice.closest("[data-reader-control]");
            const buttons = Array.from(control?.querySelectorAll("[data-reader-choice]") || []);
            const currentIndex = buttons.indexOf(activeReaderChoice);

            if (event.key === "ArrowRight" || event.key === "ArrowLeft" || event.key === "ArrowDown" || event.key === "ArrowUp") {
              event.preventDefault();
              const offset = event.key === "ArrowRight" || event.key === "ArrowDown" ? 1 : -1;
              const nextIndex = (currentIndex + offset + buttons.length) % buttons.length;
              buttons[nextIndex]?.focus();
            }

            if (event.key === "Home") {
              event.preventDefault();
              buttons[0]?.focus();
            }

            if (event.key === "End") {
              event.preventDefault();
              buttons[buttons.length - 1]?.focus();
            }
          });

          window.addEventListener("resize", () => {
            if (window.innerWidth > 760) {
              closeMobileMenu();
            }
          });

          window.addEventListener("didac-theme-change", renderThemeControls);
          window.addEventListener("didac-reader-size-change", renderReaderControls);

          document.addEventListener("astro:page-load", initPageInteractions);
        } else {
          window.DidacUI.initPageInteractions = initPageInteractions;
        }

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", initPageInteractions, { once: true });
        } else {
          initPageInteractions();
        }
      })();
    </script>
  </body>
</html>
