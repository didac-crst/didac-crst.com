---
import BaseLayout from "./BaseLayout.astro";
import ArticleFooter from "@/components/ArticleFooter.astro";
import ChipList from "@/components/ChipList.astro";
import SeriesNext from "@/components/SeriesNext.astro";
import type { CollectionEntry } from "astro:content";
import { getArticleSlug } from "@/lib/articles";
import { joinOxford } from "@/lib/meta";
import { articlePageJsonLd } from "@/lib/structured-data";
import { SITE } from "@/site.config";

type Props = {
  article: CollectionEntry<"writing">;
  relatedArticles?: CollectionEntry<"writing">[];
  readingTime: number;
};

const { article, relatedArticles = [], readingTime } = Astro.props;
const { title, description, published, updated, tags, living, version, seriesNext, hero } = article.data;
const articleSlug = getArticleSlug(article);
const seriesNextHref = seriesNext?.slug ? `/writing/${seriesNext.slug}/` : undefined;
const articleImage = `/og/writing/${articleSlug}.png`;
const heroFallback = hero?.fallback ?? hero?.src;
const heroWidth = hero?.width ?? 1600;
const heroHeight = hero?.height ?? 900;
const formatTag = (tag: string) => tag.replaceAll("-", " ");
const tagDescription = tags.length > 0
  ? `Read more about ${joinOxford(tags.slice(0, 3).map(formatTag))} by ${SITE.name}.`
  : `Read more by ${SITE.name} at didac-crst.com.`;
const structuredData = articlePageJsonLd(article, articleSlug);
---

<BaseLayout
  title={title}
  description={description}
  descriptionFallback={tagDescription}
  image={articleImage}
  author={SITE.name}
  authorUrl={SITE.domain}
  publishedTime={published.toISOString()}
  modifiedTime={(updated ?? published).toISOString()}
  type="article"
  canonical={`/writing/${articleSlug}/`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <article>
    <div class="page-container article-layout">
      <header class="article-header stack" data-motion-enter>
        <div class="cluster">
          <p class="eyebrow">Writing</p>
          {living && <span class="status-badge">Living article</span>}
          {version && <span class="status-badge">{version}</span>}
        </div>
        <h1>{title}</h1>
        <p class="lede">{description}</p>
        <div class="meta">
          <span>{readingTime} min read</span>
          <time datetime={published.toISOString()}>
            Published {published.toLocaleDateString("en", {
              year: "numeric",
              month: "long",
              day: "numeric"
            })}
          </time>
          {
            updated && (
              <time datetime={updated.toISOString()}>
                Updated {updated.toLocaleDateString("en", {
                  year: "numeric",
                  month: "long",
                  day: "numeric"
                })}
              </time>
            )
          }
        </div>
        {
          tags.length > 0 && (
            <ChipList items={tags} label="Tags" />
          )
        }
      </header>
      {
        hero && (
          <figure class="article-hero" data-motion-enter>
            <picture>
              {
                hero.src.endsWith(".avif") ? (
                  <source srcset={hero.src} type="image/avif" />
                ) : hero.src.endsWith(".webp") ? (
                  <source srcset={hero.src} type="image/webp" />
                ) : null
              }
              <img
                src={heroFallback}
                alt={hero.alt}
                width={heroWidth}
                height={heroHeight}
                decoding="async"
                fetchpriority="high"
              />
            </picture>
          </figure>
        )
      }
      <div class="article-content">
        <slot />
      </div>
      {
        seriesNext && (
          <SeriesNext
            title={seriesNext.title}
            description={seriesNext.description}
            href={seriesNextHref}
          />
        )
      }
    </div>
    <ArticleFooter article={article} relatedArticles={relatedArticles} />
  </article>
</BaseLayout>
