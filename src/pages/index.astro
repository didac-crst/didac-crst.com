---
import ArticleCard from "@/components/ArticleCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/projects";
import { SITE } from "@/site.config";
import { getCollection } from "astro:content";

const allArticles = (await getCollection("writing"))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const articles = allArticles.slice(0, 2);

const writingHeading =
  allArticles.length >= 3 ? "Selected Writing" : "Latest Writing";
const writingTitle =
  allArticles.length >= 3
    ? "Notes on durable technical systems."
    : "Architecture notes for long-lived systems.";
const projectHeading =
  projects.length >= 3 ? "Selected Projects" : "Current Project";
const projectTitle =
  projects.length >= 3
    ? "Public work as it becomes ready to document."
    : "AtlasDocs";
---

<BaseLayout>
  <section class="hero page-container">
    <div class="hero-copy">
      <p class="eyebrow">Knowledge Systems · Information Architecture · Applied AI</p>
      <h1 class="hero-name">{SITE.name}</h1>
      <p class="lede">
        I design systems that turn fragmented information into structured, traceable,
        usable knowledge.
      </p>
      <SocialLinks />
    </div>
    <aside class="positioning" aria-label="Positioning">
      <p>Deterministic when possible.</p>
      <p>Probabilistic when useful.</p>
      <p>AI where it earns its complexity.</p>
    </aside>
  </section>

  <section class="section">
    <div class="page-container stack">
      <div class="section-heading">
        <p class="eyebrow">{writingHeading}</p>
        <h2>{writingTitle}</h2>
      </div>
      <div class={`card-grid ${articles.length === 1 ? "single" : ""}`}>
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>

  <section class="section">
    <div class="page-container stack">
      <div class="section-heading">
        <p class="eyebrow">{projectHeading}</p>
        <h2>{projectTitle}</h2>
      </div>
      <div class={`card-grid ${projects.length === 1 ? "single" : ""}`}>
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(19rem, 0.75fr);
    gap: var(--space-7);
    align-items: end;
    padding-block: var(--space-8);
  }

  .hero-copy {
    max-width: 58rem;
    animation: enter var(--duration-medium) ease both;
  }

  .hero-name {
    margin: 0;
    font-size: clamp(3.5rem, 7vw, 7rem);
    line-height: 0.95;
    white-space: nowrap;
  }

  .hero .lede {
    max-width: 40rem;
    margin-block: var(--space-5);
  }

  @media (min-width: 900px) {
    .hero .eyebrow {
      white-space: nowrap;
    }
  }

  .positioning {
    max-width: 32rem;
    padding: var(--space-5) 0 var(--space-1) var(--space-5);
    border-left: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: clamp(1rem, 0.94rem + 0.28vw, 1.16rem);
    line-height: 1.65;
  }

  .positioning p {
    margin: 0;
    color: var(--color-text);
    font-weight: 700;
  }

  .positioning p + p {
    margin-top: var(--space-2);
  }

  .section-heading {
    max-width: 42rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.85rem, 1.55rem + 1.1vw, 2.7rem);
    line-height: 1.08;
  }

  @keyframes enter {
    from {
      opacity: 0;
      transform: translateY(10px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .hero-name {
      white-space: normal;
    }

    .positioning {
      max-width: 38rem;
      padding: var(--space-4) 0 0;
      border-left: 0;
      border-top: 1px solid var(--color-border);
    }
  }
</style>
