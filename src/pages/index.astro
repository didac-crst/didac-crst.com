---
import ArticleCard from "@/components/ArticleCard.astro";
import Identity from "@/components/Identity.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import home from "@/home.config.json";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { homeJsonLd } from "@/lib/structured-data";
import { projects } from "@/projects";
import { getCollection } from "astro:content";

const allArticles = (await getCollection("writing"))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const latestArticle = allArticles[0];

const currentProject =
  projects.find((project) => project.status === "active") ?? projects[0];

const { motto, lede, pillars, stance } = home;
const homeDescription =
  `${motto.join(" ")} ${lede} Focus areas: ${pillars.join(", ")}.`;
const structuredData = homeJsonLd();
---

<BaseLayout description={homeDescription}>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <section class="hero page-container" data-motion-home>
    <div class="hero-copy">
      <div class="hero-lockup">
        <div class="hero-identity-wrapper" data-hero-identity-wrapper>
          <Identity variant="hero" />
        </div>
        <div class="hero-details">
          <p class="hero-philosophy">
            {motto.join(" ")}
          </p>
          <p class="hero-support">{lede}</p>
          <ul class="hero-pillars" aria-label="Areas of focus">
            {pillars.map((pillar) => <li>{pillar}</li>)}
          </ul>
          <div class="hero-actions">
            <SocialLinks />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section stance-section" data-motion-reveal>
    <div class="page-container stance">
      <div class="section-heading">
        <p class="eyebrow">Point of view</p>
        <h2>{stance.title}</h2>
      </div>
      <div class="stance-body reading-flow">
        {stance.paragraphs.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </section>

  <section class="section" data-motion-reveal aria-labelledby="home-writing-heading">
    <div class="page-container stack">
      <h2 id="home-writing-heading" class="eyebrow section-label">
        <a href="/writing/">Writing</a>
      </h2>
      {
        latestArticle && (
          <div class="card-grid single">
            <ArticleCard article={latestArticle} badge="Latest" />
          </div>
        )
      }
    </div>
  </section>

  <section class="section" data-motion-reveal aria-labelledby="home-projects-heading">
    <div class="page-container stack">
      <h2 id="home-projects-heading" class="eyebrow section-label">
        <a href="/projects/">Projects</a>
      </h2>
      {
        currentProject && (
          <div class="card-grid single">
            <ProjectCard project={currentProject} badge="Current" />
          </div>
        )
      }
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    align-items: start;
    padding-block: var(--space-8);
  }

  .hero-copy {
    max-width: none;
    width: 100%;
  }

  .hero-lockup {
    --hero-logo-size: clamp(4.55rem, 5.45vw, 5rem);
    --hero-identity-gap: 0.8rem;
    display: grid;
    gap: 0;
    max-width: 100%;
  }

  .hero-identity-wrapper {
    width: fit-content;
    max-width: 100%;
  }

  .hero-details {
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
    /* Wide screens: align with the name (D of Didac), not the logo. */
    padding-left: calc(var(--hero-logo-size) + var(--hero-identity-gap));
  }

  .hero-philosophy {
    max-width: none;
    margin: 0;
    color: var(--color-accent-strong);
    font-size: clamp(1.35rem, 1.05rem + 1.25vw, 2.35rem);
    font-weight: 700;
    line-height: 1.22;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .hero-support {
    width: 100%;
    max-width: none;
    margin: 0;
    color: var(--color-muted);
    font-size: calc(var(--article-font-size) * 1.06);
    font-weight: 500;
    line-height: var(--article-line-height);
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .hero-pillars {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-pillars li {
    display: inline-flex;
    min-height: 2.5rem;
    align-items: center;
    padding: 0.52rem 1.15rem;
    border: 1px solid color-mix(in srgb, var(--color-warm-accent) 42%, transparent);
    border-radius: 999px;
    color: var(--color-warm-accent);
    font-size: 1.05rem;
    font-weight: 650;
    line-height: 1;
    transition:
      transform var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard),
      background-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .hero-pillars li:hover {
    border-color: color-mix(in srgb, var(--color-warm-accent) 72%, var(--color-border));
    background: color-mix(in srgb, var(--color-warm-accent) 10%, transparent);
    color: color-mix(in srgb, var(--color-warm-accent) 88%, var(--color-text));
    transform: translateY(-2px);
  }

  .hero-actions {
    margin-top: var(--space-3);
  }

  .hero-actions :global(.social-links) {
    margin: 0;
  }

  .section-heading {
    max-width: none;
    width: 100%;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.85rem, 1.55rem + 1.1vw, 2.7rem);
    line-height: 1.08;
  }

  .section-label {
    margin-bottom: 0;
  }

  .section-label a {
    color: inherit;
    text-decoration: none;
  }

  .section-label a:hover {
    text-decoration: underline;
    text-underline-offset: 0.18em;
  }

  .stance {
    display: grid;
    gap: var(--space-5);
  }

  .stance-body {
    display: grid;
    gap: var(--space-4);
    max-width: none;
    width: 100%;
  }

  .stance-body p {
    margin: 0;
    color: var(--color-muted);
  }

  @media (max-width: 860px) {
    .hero {
      gap: var(--space-5);
    }

    .hero-lockup {
      --hero-logo-size: clamp(3rem, 11vw, 3.15rem);
      --hero-identity-gap: 0.65rem;
    }

    .hero-details {
      /* Extra room so the docking logo doesn’t graze the motto while scrolling. */
      margin-top: clamp(2.75rem, 8vw, 3.5rem);
      padding-left: 0;
    }

    .hero-philosophy {
      font-size: clamp(1.25rem, 5.4vw, 2rem);
      text-align: left;
      text-justify: auto;
      hyphens: manual;
      -webkit-hyphens: manual;
    }

    .hero-pillars {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.65rem;
    }

    .hero-pillars li {
      width: fit-content;
    }
  }

  @media (max-width: 430px) {
    .hero-lockup {
      --hero-logo-size: clamp(3rem, 12.5vw, 3.1rem);
      --hero-identity-gap: 0.55rem;
    }
  }
</style>
