---
import ArticleCard from "@/components/ArticleCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/projects";
import { SITE } from "@/site.config";
import { getCollection } from "astro:content";

const allArticles = (await getCollection("writing"))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const articles = allArticles.slice(0, 2);

const writingHeading =
  allArticles.length >= 3 ? "Selected Writing" : "Latest Writing";
const writingTitle =
  allArticles.length >= 3
    ? "Notes on durable technical systems."
    : "Architecture notes for long-lived systems.";
const projectHeading =
  projects.length >= 3 ? "Selected Projects" : "Current Project";
const projectTitle =
  projects.length >= 3
    ? "Public work as it becomes ready to document."
    : "AtlasDocs";
---

<BaseLayout>
  <section class="hero page-container" data-motion-home>
    <div class="hero-copy">
      <div class="hero-brand-lockup">
        <img class="hero-lockup-logo" src={SITE.logo} alt="" width="56" height="56" aria-hidden="true" />
        <h1 class="hero-name">{SITE.name}</h1>
      </div>
      <div class="eyebrow hero-disciplines" aria-label="Knowledge Systems, Information Architecture, Applied AI">
        <span>Knowledge Systems</span>
        <span>Information Architecture</span>
        <span>Applied AI</span>
      </div>
      <p class="lede">
        I design systems that turn fragmented information into structured, traceable,
        usable knowledge.
      </p>
    </div>
    <aside class="positioning" aria-label="Positioning">
      <p>Deterministic when possible.</p>
      <p>Probabilistic when useful.</p>
      <p>AI where it earns its complexity.</p>
    </aside>
    <div class="hero-actions">
      <SocialLinks />
    </div>
  </section>

  <section class="section" data-motion-reveal>
    <div class="page-container stack">
      <div class="section-heading">
        <p class="eyebrow">{writingHeading}</p>
        <h2>{writingTitle}</h2>
      </div>
      <div class={`card-grid ${articles.length === 1 ? "single" : ""}`}>
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>

  <section class="section" data-motion-reveal>
    <div class="page-container stack">
      <div class="section-heading">
        <p class="eyebrow">{projectHeading}</p>
        <h2>{projectTitle}</h2>
      </div>
      <div class={`card-grid ${projects.length === 1 ? "single" : ""}`}>
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1.55fr) minmax(19rem, 0.75fr);
    column-gap: var(--space-7);
    row-gap: var(--space-5);
    align-items: end;
    padding-block: var(--space-8);
  }

  .hero-copy {
    grid-column: 1;
    max-width: 58rem;
  }

  .hero-brand-lockup {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
    max-width: 100%;
    white-space: nowrap;
  }

  .hero-lockup-logo {
    width: clamp(4.55rem, 5.45vw, 5rem);
    height: clamp(4.55rem, 5.45vw, 5rem);
    flex: 0 0 auto;
    object-fit: contain;
    transform: translateY(0.18rem);
  }

  .hero-name {
    margin: 0;
    font-size: clamp(3.15rem, 6.3vw, 6.3rem);
    line-height: 0.95;
    white-space: nowrap;
  }

  .hero-brand-lockup + .hero-disciplines {
    margin-top: var(--space-5);
    font-size: 0.94rem;
    font-weight: 750;
    letter-spacing: 0.1em;
  }

  .hero .lede {
    max-width: 40rem;
    margin-block: var(--space-6) var(--space-5);
  }

  .positioning {
    grid-column: 2;
    grid-row: 1 / span 2;
    max-width: 32rem;
    padding: var(--space-5) 0 var(--space-1) var(--space-5);
    border-left: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: clamp(1rem, 0.94rem + 0.28vw, 1.16rem);
    line-height: 1.65;
  }

  .positioning p {
    margin: 0;
    color: var(--color-text);
    font-weight: 700;
  }

  .positioning p + p {
    margin-top: var(--space-2);
  }

  .hero-actions {
    grid-column: 1;
  }

  .section-heading {
    max-width: 42rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.85rem, 1.55rem + 1.1vw, 2.7rem);
    line-height: 1.08;
  }

  @media (max-width: 860px) {
    .hero {
      grid-template-columns: 1fr;
      gap: var(--space-5);
    }

    .hero-copy,
    .positioning,
    .hero-actions {
      grid-column: 1;
    }

    .hero-brand-lockup {
      gap: 0.65rem;
    }

    .hero-lockup-logo {
      width: clamp(3rem, 11vw, 3.15rem);
      height: clamp(3rem, 11vw, 3.15rem);
    }

    .hero-name {
      font-size: clamp(2.1rem, 9.45vw, 3.6rem);
    }

    .hero-brand-lockup + .hero-disciplines {
      font-size: 0.86rem;
      line-height: 1.65;
    }

    .positioning {
      grid-row: auto;
      max-width: 38rem;
      padding: var(--space-4) 0 0;
      border-left: 0;
      border-top: 0;
    }
  }

  @media (max-width: 430px) {
    .hero-brand-lockup {
      gap: 0.55rem;
    }

    .hero-lockup-logo {
      width: clamp(3rem, 12.5vw, 3.1rem);
      height: clamp(3rem, 12.5vw, 3.1rem);
    }

    .hero-name {
      font-size: clamp(1.95rem, 8.8vw, 3rem);
    }
  }
</style>
