---
import ArticleCard from "@/components/ArticleCard.astro";
import ProjectCard from "@/components/ProjectCard.astro";
import SocialLinks from "@/components/SocialLinks.astro";
import home from "@/home.config.json";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { joinOxford } from "@/lib/meta";
import { projects } from "@/projects";
import { SITE } from "@/site.config";
import { getCollection } from "astro:content";

const allArticles = (await getCollection("writing"))
  .filter((article) => !article.data.draft)
  .sort((a, b) => b.data.published.valueOf() - a.data.published.valueOf());
const articles = allArticles.slice(0, 2);

const writingHeading =
  allArticles.length >= 3 ? "Selected Writing" : "Latest Writing";
const writingTitle =
  allArticles.length >= 3
    ? "Notes on durable technical systems."
    : "Architecture notes for long-lived systems.";
const projectHeading =
  projects.length >= 3 ? "Selected Projects" : "Current Project";
const projectTitle =
  projects.length >= 3
    ? "Public work as it becomes ready to document."
    : "AtlasDocs";

const { motto, pillars } = home;
const homeDescription = `${motto.join(" ")} Explore ${joinOxford(pillars.map((pillar) => pillar.toLowerCase()))}.`;
---

<BaseLayout description={homeDescription}>
  <section class="hero page-container" data-motion-home>
    <div class="hero-copy">
      <div class="hero-lockup">
        <img class="hero-lockup-logo" src={SITE.logo} alt="" width="56" height="56" aria-hidden="true" />
        <h1 class="hero-name">{SITE.name}</h1>
        <div class="hero-details">
          <p class="hero-philosophy">
            {motto[0]}<br />
            {motto[1]}
          </p>
          <ul class="hero-pillars" aria-label="Areas of focus">
            {pillars.map((pillar) => <li>{pillar}</li>)}
          </ul>
          <div class="hero-actions">
            <SocialLinks />
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section" data-motion-reveal>
    <div class="page-container stack">
      <div class="section-heading">
        <p class="eyebrow">{writingHeading}</p>
        <h2>{writingTitle}</h2>
      </div>
      <div class={`card-grid ${articles.length === 1 ? "single" : ""}`}>
        {articles.map((article) => <ArticleCard article={article} />)}
      </div>
    </div>
  </section>

  <section class="section" data-motion-reveal>
    <div class="page-container stack">
      <div class="section-heading">
        <p class="eyebrow">{projectHeading}</p>
        <h2>{projectTitle}</h2>
      </div>
      <div class={`card-grid ${projects.length === 1 ? "single" : ""}`}>
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .hero {
    display: grid;
    gap: var(--space-5);
    align-items: start;
    padding-block: var(--space-8);
  }

  .hero-copy {
    max-width: 58rem;
  }

  .hero-lockup {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    align-items: center;
    column-gap: 0.8rem;
    max-width: 100%;
  }

  .hero-lockup-logo {
    grid-column: 1;
    grid-row: 1;
    width: clamp(4.55rem, 5.45vw, 5rem);
    height: clamp(4.55rem, 5.45vw, 5rem);
    flex: 0 0 auto;
    object-fit: contain;
    transform: translateY(0.18rem);
  }

  .hero-name {
    grid-column: 2;
    grid-row: 1;
    margin: 0;
    font-size: clamp(3.15rem, 6.3vw, 6.3rem);
    line-height: 0.95;
    white-space: nowrap;
  }

  .hero-details {
    grid-column: 2;
    display: grid;
    gap: var(--space-5);
    margin-top: var(--space-6);
  }

  .hero-philosophy {
    max-width: 50rem;
    margin: 0;
    color: var(--color-accent-strong);
    font-size: clamp(1.35rem, 1.05rem + 1.25vw, 2.35rem);
    font-weight: 700;
    line-height: 1.22;
  }

  .hero-pillars {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .hero-pillars li {
    display: inline-flex;
    min-height: 2.35rem;
    align-items: center;
    padding: 0.52rem 1.1rem;
    border: 1px solid color-mix(in srgb, var(--color-warm-accent) 42%, transparent);
    border-radius: 999px;
    color: var(--color-warm-accent);
    font-size: 0.92rem;
    font-weight: 650;
    line-height: 1;
    transition:
      transform var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard),
      background-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .hero-pillars li:hover {
    border-color: color-mix(in srgb, var(--color-warm-accent) 72%, var(--color-border));
    background: color-mix(in srgb, var(--color-warm-accent) 10%, transparent);
    color: color-mix(in srgb, var(--color-warm-accent) 88%, var(--color-text));
    transform: translateY(-2px);
  }

  .hero-actions {
    margin-top: var(--space-3);
  }

  .hero-actions :global(.social-links) {
    margin: 0;
  }

  .section-heading {
    max-width: 42rem;
  }

  .section-heading h2 {
    margin: 0;
    font-size: clamp(1.85rem, 1.55rem + 1.1vw, 2.7rem);
    line-height: 1.08;
  }

  @media (max-width: 860px) {
    .hero {
      gap: var(--space-5);
    }

    .hero-lockup {
      column-gap: 0.65rem;
    }

    .hero-lockup-logo {
      width: clamp(3rem, 11vw, 3.15rem);
      height: clamp(3rem, 11vw, 3.15rem);
    }

    .hero-name {
      font-size: clamp(2.1rem, 9.45vw, 3.6rem);
    }

    .hero-details {
      grid-column: 1 / -1;
      margin-top: var(--space-5);
    }

    .hero-philosophy {
      font-size: clamp(1.25rem, 5.4vw, 2rem);
    }

    .hero-pillars {
      flex-direction: column;
      align-items: flex-start;
      gap: 0.65rem;
    }

    .hero-pillars li {
      width: fit-content;
    }
  }

  @media (max-width: 430px) {
    .hero-lockup {
      column-gap: 0.55rem;
    }

    .hero-lockup-logo {
      width: clamp(3rem, 12.5vw, 3.1rem);
      height: clamp(3rem, 12.5vw, 3.1rem);
    }

    .hero-name {
      font-size: clamp(1.95rem, 8.8vw, 3rem);
    }
  }
</style>
