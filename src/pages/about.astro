---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ChipList from "@/components/ChipList.astro";
import { personPageJsonLd } from "@/lib/structured-data";
import { SITE } from "@/site.config";

const languages = [...SITE.knowsLanguage];
const interests = [...SITE.knowsAbout];
const structuredData = personPageJsonLd();
---

<BaseLayout
  title="About"
  description={`About ${SITE.fullName}: systems that turn information into understanding and better decisions.`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <section class="section">
    <div class="page-container about-page">
      <header class="page-hero" data-motion-enter>
        <div class="about-hero-title">
          <p class="eyebrow">About</p>
          <h1 class="page-title">Who decides what persists.</h1>
        </div>
        <div class="about-hero-body">
          <figure class="about-portrait">
            <img
              src="/images/didac-cristobal.webp"
              alt="Portrait of Didac Cristobal"
              width="440"
              height="440"
              loading="eager"
              decoding="async"
            />
            <figcaption>
              <strong>Didac Cristobal</strong>
              <span>Toulouse, France</span>
            </figcaption>
          </figure>
          <div class="about-hero-content">
            <div class="reading-flow">
              <p class="lede">
                I am an engineer interested in how systems transform information into
                understanding and better decisions.
              </p>
              <p>
                My work sits at the intersection of software architecture, data, knowledge
                engineering, and applied AI.
              </p>
              <p>
                I design systems by choosing the simplest reliable approach for each problem:
                deterministic logic when rules are enough, statistical methods when patterns
                need to be discovered, and semantic AI when meaning and reasoning genuinely
                add value.
              </p>
              <p>
                <strong>
                  The goal is not to add intelligence everywhere. It is to build systems where
                  each component does what it is best suited for.
                </strong>
              </p>
            </div>
          </div>
        </div>
      </header>

      <section class="about-section" data-motion-reveal>
        <div class="section-label">
          <h2>How I work</h2>
        </div>
        <div class="section-body">
          <div class="reading-flow">
            <p>
              I approach problems as systems rather than isolated features.
            </p>
            <p>
              That means understanding where information comes from, how it evolves, how
              trustworthy it is, how concepts relate to each other, and which parts should
              remain predictable.
            </p>
            <p>
              I am particularly interested in architectures that combine structured data,
              documents, ontologies, classifiers, clustering, embeddings, and language
              models — while keeping clear boundaries between deterministic foundations and
              probabilistic capabilities.
            </p>
          </div>
          <ol class="principle-flow" aria-label="Architectural principle">
            <li>Deterministic when possible</li>
            <li>Statistical when appropriate</li>
            <li>Semantic AI when valuable</li>
          </ol>
        </div>
      </section>

      <section class="about-section" data-motion-reveal>
        <div class="section-label">
          <h2>Experience</h2>
        </div>
        <div class="section-body">
          <ol class="timeline">
            <li>
              <div class="experience-heading">
                <h3>Quality Engineering & Analytics</h3>
                <p>
                  <span class="tag">Airbus</span>
                  <span class="tag">2025–Present</span>
                  <span class="tag">Toulouse</span>
                </p>
              </div>
              <p>
                Working on large-scale quality analytics and AI initiatives across engineering,
                with a growing focus on transforming fragmented operational information into
                trusted knowledge. This naturally evolved into designing architectures that
                combine deterministic systems, structured data and language models to solve
                complex information problems.
              </p>
            </li>
            <li>
              <div class="experience-heading">
                <h3>Flight Data Analytics & Predictive Maintenance</h3>
                <p>
                  <span class="tag">Airbus</span>
                  <span class="tag">2022–2025</span>
                  <span class="tag">Hamburg</span>
                </p>
              </div>
              <p>
                Worked at the intersection of engineering, operational data and statistical
                analysis, building solutions where decisions were increasingly driven by
                evidence rather than intuition. This strengthened my understanding of how data
                becomes actionable knowledge.
              </p>
            </li>
            <li>
              <div class="experience-heading">
                <h3>Product Management</h3>
                <p>
                  <span class="tag">Satair</span>
                  <span class="tag">2018–2022</span>
                  <span class="tag">Hamburg</span>
                </p>
              </div>
              <p>
                Expanded beyond engineering into product strategy, customer value and business
                decision-making. This perspective taught me that useful systems must balance
                technical correctness with operational and commercial realities.
              </p>
            </li>
            <li>
              <div class="experience-heading">
                <h3>Information Systems</h3>
                <p>
                  <span class="tag">Airbus</span>
                  <span class="tag">2011–2018</span>
                  <span class="tag">Hamburg</span>
                </p>
              </div>
              <p>
                Built my engineering foundation by leading enterprise information system
                transformations across SAP, PLM, and manufacturing environments. This is where
                I learned that successful systems depend as much on information flows, process
                design, and long-term maintainability as on technology itself.
              </p>
            </li>
          </ol>
        </div>
      </section>

      <section class="about-section" data-motion-reveal>
        <div class="section-label">
          <h2>Different perspectives.<br />One architecture.</h2>
        </div>
        <div class="section-body reading-flow">
          <p>
            Each role taught me to solve the same underlying problem from a different
            perspective. Together they shaped the way I think about designing information
            architectures today.
          </p>
          <p>
            As an information systems project leader, I learned that successful systems start
            before technology: with clear information flows, well-defined requirements, and an
            understanding of how people and processes interact. Product management taught me
            that good systems must balance engineering decisions with business priorities and
            user needs. Data analytics showed me how evidence can improve decisions. Quality
            engineering made me realize that many organizations do not struggle because they
            lack data; they struggle because they cannot turn fragmented information into
            trusted knowledge.
          </p>
          <p>
            Technical correctness is only one part of a useful system. It also has to fit the
            organization, preserve the meaning of information over time, remain understandable,
            and help people make better decisions.
          </p>
          <p>
            That is why I increasingly design architectures that combine deterministic logic,
            structured knowledge, and language models, using each where it contributes the most
            value instead of expecting AI to solve every problem.
          </p>
        </div>
      </section>

      <section class="about-section" data-motion-reveal>
        <div class="section-label">
          <h2>Beyond professional work</h2>
        </div>
        <div class="section-body reading-flow">
          <p>
            Beyond professional projects, I enjoy building small systems that apply the same
            principles to everyday life — from home automation and personal dashboards to
            simulations exploring long-term decisions and trade-offs.
          </p>
          <p>
            These experiments are a way to explore ideas through building: observing systems,
            modelling complexity, testing assumptions, and turning abstract concepts into
            something tangible.
          </p>
        </div>
      </section>

      <section class="about-section" data-motion-reveal>
        <div class="section-label">
          <h2>Education</h2>
        </div>
        <div class="section-body">
          <p class="section-intro">
            My formal background combines engineering and business. Engineering gave me a
            systems perspective; the MBA added strategy, organizations, and economics to it.
          </p>
          <div class="education-list">
            <div class="education-item">
              <div class="item-heading">
                <h3>Executive MBA</h3>
                <p>
                  <span class="tag">ESADE Business School</span>
                  <span class="tag">2016–2018</span>
                  <span class="tag">Barcelona</span>
                </p>
              </div>
              <p>
                Specialized in strategic management, innovation and business leadership.
                Exchange semester at the International University of Japan.
              </p>
            </div>
            <div class="education-item">
              <div class="item-heading">
                <h3>MSc Electronic Engineering · Dual Degree</h3>
                <p>
                  <span class="tag">Grenoble INP · Phelma</span>
                  <span class="tag">2007–2009</span>
                  <span class="tag">Grenoble</span>
                </p>
              </div>
              <p>
                Specialized in electronics, signal processing and information theory while
                completing a dual-degree program with UPC.
              </p>
            </div>
            <div class="education-item">
              <div class="item-heading">
                <h3>MSc Telecommunications Engineering</h3>
                <p>
                  <span class="tag">UPC · TelecomBCN</span>
                  <span class="tag">2005–2008</span>
                  <span class="tag">Barcelona</span>
                </p>
              </div>
              <p>
                Focused on telecommunications systems, networking and signal processing.
              </p>
            </div>
            <div class="education-item">
              <div class="item-heading">
                <h3>BSc Telecommunications Engineering</h3>
                <p>
                  <span class="tag">UPC</span>
                  <span class="tag">2001–2005</span>
                  <span class="tag">Barcelona</span>
                </p>
              </div>
              <p>
                Built the engineering foundations in mathematics, electronics and
                telecommunications.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="about-section compact" data-motion-reveal>
        <div class="section-label">
          <h2>Current interests</h2>
        </div>
        <div class="section-body">
          <ChipList items={interests} label="Current interests" />
        </div>
      </section>

      <section class="about-section compact" data-motion-reveal>
        <div class="section-label">
          <h2>Languages</h2>
        </div>
        <div class="section-body">
          <ChipList items={languages} label="Languages" />
        </div>
      </section>

      <section class="about-section compact" data-motion-reveal>
        <div class="section-label">
          <h2>Contact</h2>
        </div>
        <div class="section-body">
          <ul class="contact-list" aria-label="Contact">
            <li>
              <a href={`mailto:${SITE.email}`}>
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V6c0-1.1-.9-2-2-2Zm0 4-8 5L4 8V6l8 5 8-5v2Z" />
                </svg>
                <span>{SITE.email}</span>
              </a>
            </li>
            <li>
              <a href={SITE.linkedin} rel="me noopener noreferrer" target="_blank">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M20.45 20.45h-3.55v-5.57c0-1.33-.03-3.04-1.85-3.04-1.85 0-2.14 1.45-2.14 2.94v5.67H9.35V9h3.41v1.56h.05c.48-.9 1.64-1.85 3.37-1.85 3.6 0 4.27 2.37 4.27 5.46v6.28ZM5.34 7.43a2.06 2.06 0 1 1 0-4.12 2.06 2.06 0 0 1 0 4.12Zm1.78 13.02H3.56V9h3.56v11.45ZM22.23 0H1.77C.79 0 0 .77 0 1.73v20.54C0 23.23.79 24 1.77 24h20.46c.98 0 1.77-.77 1.77-1.73V1.73C24 .77 23.21 0 22.23 0Z" />
                </svg>
                <span>LinkedIn</span>
              </a>
            </li>
            <li>
              <a href={SITE.github} rel="me noopener noreferrer" target="_blank">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                  <path d="M12 2a10 10 0 0 0-3.16 19.49c.5.09.68-.22.68-.48v-1.69c-2.78.6-3.37-1.2-3.37-1.2-.45-1.16-1.11-1.47-1.11-1.47-.91-.62.07-.61.07-.61 1 .07 1.53 1.03 1.53 1.03.9 1.52 2.35 1.08 2.92.83.09-.65.35-1.08.63-1.33-2.22-.25-4.56-1.11-4.56-4.94 0-1.09.39-1.98 1.03-2.68-.1-.25-.45-1.27.1-2.64 0 0 .84-.27 2.75 1.02A9.48 9.48 0 0 1 12 6.99c.85 0 1.7.11 2.5.34 1.9-1.29 2.74-1.02 2.74-1.02.55 1.37.2 2.39.1 2.64.64.7 1.03 1.59 1.03 2.68 0 3.84-2.34 4.68-4.57 4.93.36.31.68.92.68 1.86v2.76c0 .27.18.58.69.48A10 10 0 0 0 12 2Z" />
                </svg>
                <span>GitHub</span>
              </a>
            </li>
          </ul>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    display: grid;
    gap: var(--space-8);
  }

  .about-page .page-hero {
    gap: var(--space-6);
  }

  .about-hero-title {
    display: grid;
    gap: var(--space-4);
  }

  .about-hero-body {
    display: grid;
    grid-template-columns: minmax(12rem, 0.32fr) minmax(0, 1fr);
    align-items: start;
    column-gap: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .about-hero-content {
    grid-column: 2;
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .about-portrait {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    max-width: 13.75rem;
    /* Match first text line ink — font half-leading sits above the glyphs */
    padding-top: 0.5em;
  }

  .about-portrait img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius-medium) + 4px);
    object-fit: cover;
  }

  .about-portrait figcaption {
    display: grid;
    gap: 0.15rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .about-portrait figcaption strong {
    color: var(--color-text);
    font-weight: 700;
  }

  .reading-flow,
  .section-intro {
    max-width: none;
    width: 100%;
  }

  .reading-flow {
    display: grid;
    gap: var(--space-4);
  }

  .reading-flow p,
  .section-intro,
  .timeline p,
  .education-list p {
    margin: 0;
    color: var(--color-muted);
    font-size: 1em;
    line-height: inherit;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .about-section {
    display: grid;
    grid-template-columns: minmax(12rem, 0.32fr) minmax(0, 1fr);
    gap: var(--space-6);
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-border);
  }

  .about-section.compact {
    padding-top: var(--space-6);
  }

  .section-label h2 {
    position: sticky;
    top: 6rem;
    margin: 0;
    color: var(--color-accent-strong);
    font-size: var(--title-accent-size);
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .about-hero-body {
      grid-template-columns: 1fr;
      row-gap: var(--space-5);
    }

    .about-hero-content {
      grid-column: 1;
    }

    .about-portrait {
      width: min(10rem, 48vw);
    }
  }

  .section-body {
    display: grid;
    gap: var(--space-5);
  }

  .principle-flow {
    display: grid;
    gap: var(--space-3);
    max-width: none;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .principle-flow li {
    position: relative;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 700;
  }

  .principle-flow li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: var(--space-5);
    bottom: -0.8rem;
    width: 1px;
    height: 0.8rem;
    background: var(--color-accent);
  }

  .timeline {
    display: grid;
    gap: var(--space-6);
    max-width: none;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline li {
    display: grid;
    gap: var(--space-4);
    padding-left: var(--space-5);
    border-left: 1px solid var(--color-border);
  }

  .experience-heading,
  .item-heading {
    display: grid;
    gap: var(--space-2);
  }

  .experience-heading h3,
  .item-heading h3 {
    margin: 0;
    color: var(--color-text);
    font-size: 1.12em;
    line-height: 1.3;
  }

  .experience-heading p,
  .item-heading p {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    text-align: left;
    line-height: 0;
  }

  .contact-list {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .contact-list a {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-text);
    font-weight: 650;
    text-decoration: none;
  }

  .contact-list svg {
    width: 1.05rem;
    height: 1.05rem;
    fill: currentColor;
    flex: 0 0 auto;
  }

  .contact-list a:hover {
    color: var(--color-accent-strong);
  }

  .education-list {
    display: grid;
    gap: var(--space-5);
    max-width: none;
    width: 100%;
  }

  .education-item {
    display: grid;
    gap: var(--space-4);
    padding-left: var(--space-5);
    border-left: 1px solid var(--color-border);
  }

  .education-item:last-child {
    padding-bottom: 0;
  }

  @media (max-width: 820px) {
    .about-section {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .section-label h2 {
      position: static;
    }
  }
</style>
