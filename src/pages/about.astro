---
import BaseLayout from "@/layouts/BaseLayout.astro";
import ChipList from "@/components/ChipList.astro";
import { personPageJsonLd } from "@/lib/structured-data";
import { projects } from "@/projects";
import { SITE } from "@/site.config";

const languages = [...SITE.knowsLanguage];
const interests = [...SITE.knowsAbout];
const atlasDocs = projects.find((project) => project.slug === "atlasdocs");
const structuredData = personPageJsonLd();
---

<BaseLayout
  title="About"
  description={`About ${SITE.fullName}: knowledge engineering, information architecture, and AI-enhanced systems.`}
>
  <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <section class="section">
    <div class="page-container about-page">
      <header class="page-hero" data-motion-enter>
        <div class="about-hero-title">
          <p class="eyebrow">About</p>
          <h1 class="page-title">Who decides what persists.</h1>
        </div>
        <div class="about-hero-body">
          <figure class="about-portrait">
            <img
              src="/images/didac-cristobal.webp"
              alt="Portrait of Didac Cristobal"
              width="440"
              height="440"
              loading="eager"
              decoding="async"
            />
            <figcaption>
              <strong>Didac Cristobal</strong>
              <span>Toulouse, France</span>
            </figcaption>
          </figure>
          <div class="about-hero-content">
            <div class="reading-flow">
              <p class="lede">
                I am an engineer working at the intersection of information systems, data,
                knowledge architecture, and applied AI.
              </p>
              <p>
                I design systems by choosing the simplest reliable method for each problem:
                deterministic logic where rules are sufficient, statistical and machine-learning
                methods where they fit, and language models where semantic reasoning genuinely
                adds value.
              </p>
            </div>
            <section class="hero-subsection" aria-labelledby="how-i-work-heading">
              <h2 id="how-i-work-heading">How I work</h2>
              <div class="reading-flow">
                <p>
                  I approach problems as systems rather than isolated features.
                </p>
                <p>
                  That usually means understanding where information comes from, how it changes,
                  how reliable it is, how different concepts relate to one another, and which
                  parts of the process should remain deterministic.
                </p>
                <p>
                  I am particularly interested in architectures that combine structured data,
                  documents, ontologies, classifiers, clustering, embeddings, and language models
                  without making probabilistic AI responsible for problems that can be solved more
                  predictably.
                </p>
              </div>
            </section>
            <ol class="principle-flow hero-principles" aria-label="Architectural principle">
              <li>Deterministic when possible</li>
              <li>Statistical when appropriate</li>
              <li>Semantic AI when valuable</li>
            </ol>
          </div>
        </div>
      </header>

      <section class="about-section" data-motion-reveal>
        <div class="section-label">
          <h2>Experience</h2>
        </div>
        <div class="section-body">
          <ol class="timeline">
            <li>
              <div class="experience-heading">
                <h3>Quality Engineering & Analytics</h3>
                <p>
                  <span class="metadata-pill">Airbus</span>
                  <span class="metadata-pill">2025–Present</span>
                  <span class="metadata-pill">Toulouse</span>
                </p>
              </div>
              <p>
                Working on large-scale quality analytics and AI initiatives across engineering,
                with a growing focus on transforming fragmented operational information into
                trusted knowledge. This naturally evolved into designing architectures that
                combine deterministic systems, structured data and language models to solve
                complex information problems.
              </p>
            </li>
            <li>
              <div class="experience-heading">
                <h3>Flight Data Analytics & Predictive Maintenance</h3>
                <p>
                  <span class="metadata-pill">Airbus</span>
                  <span class="metadata-pill">2022–2025</span>
                  <span class="metadata-pill">Hamburg</span>
                </p>
              </div>
              <p>
                Worked at the intersection of engineering, operational data and statistical
                analysis, building solutions where decisions were increasingly driven by
                evidence rather than intuition. This strengthened my understanding of how data
                becomes actionable knowledge.
              </p>
            </li>
            <li>
              <div class="experience-heading">
                <h3>Product Management</h3>
                <p>
                  <span class="metadata-pill">Satair</span>
                  <span class="metadata-pill">2018–2022</span>
                  <span class="metadata-pill">Hamburg</span>
                </p>
              </div>
              <p>
                Expanded beyond engineering into product strategy, customer value and business
                decision-making. This perspective taught me that useful systems must balance
                technical correctness with operational and commercial realities.
              </p>
            </li>
            <li>
              <div class="experience-heading">
                <h3>Information Systems</h3>
                <p>
                  <span class="metadata-pill">Airbus</span>
                  <span class="metadata-pill">2011–2018</span>
                  <span class="metadata-pill">Hamburg</span>
                </p>
              </div>
              <p>
                Built the engineering foundation by designing enterprise information systems
                across SAP, PLM and manufacturing. This is where I learned that successful
                software depends as much on information flow, process design and long-term
                maintainability as on technology itself.
              </p>
            </li>
          </ol>
        </div>
      </section>

      <section class="about-section" data-motion-reveal>
        <div class="section-label">
          <h2>Different perspectives.<br />One architecture.</h2>
        </div>
        <div class="section-body reading-flow">
          <p>
            Each role taught me to solve the same underlying problem from a different
            perspective. Together they shaped the way I design information architectures today.
          </p>
          <p>
            As an information systems engineer, I learned that software succeeds only when
            information flows reliably across an organization. Product management taught me
            that good systems must balance engineering decisions with business priorities and
            user needs. Data analytics showed me how evidence can improve decisions. Quality
            engineering made me realize that many organizations do not struggle because they
            lack data; they struggle because they cannot turn fragmented information into
            trusted knowledge.
          </p>
          <p>
            Technical correctness is only one part of a useful system. It also has to fit the
            organization, preserve the meaning of information over time, remain understandable,
            and help people make better decisions.
          </p>
          <p>
            That is why I increasingly design architectures that combine deterministic logic,
            structured knowledge, and language models, using each where it contributes the most
            value instead of expecting AI to solve every problem.
          </p>
        </div>
      </section>

      <section class="about-section" data-motion-reveal>
        <div class="section-label">
          <h2>Education</h2>
        </div>
        <div class="section-body">
          <p class="section-intro">
            My formal background combines engineering and business. Engineering gave me a
            systems perspective; the MBA added strategy, organizations, and economics to it.
          </p>
          <div class="education-list">
            <div class="education-item">
              <div class="item-heading">
                <h3>Executive MBA</h3>
                <p>
                  <span class="metadata-pill">ESADE Business School</span>
                  <span class="metadata-pill">2016–2018</span>
                  <span class="metadata-pill">Barcelona</span>
                </p>
              </div>
              <p>
                Specialized in strategic management, innovation and business leadership.
                Exchange semester at the International University of Japan.
              </p>
            </div>
            <div class="education-item">
              <div class="item-heading">
                <h3>MSc Electronic Engineering · Dual Degree</h3>
                <p>
                  <span class="metadata-pill">Grenoble INP · Phelma</span>
                  <span class="metadata-pill">2007–2009</span>
                  <span class="metadata-pill">Grenoble</span>
                </p>
              </div>
              <p>
                Specialized in electronics, signal processing and information theory while
                completing a dual-degree program with UPC.
              </p>
            </div>
            <div class="education-item">
              <div class="item-heading">
                <h3>MSc Telecommunications Engineering</h3>
                <p>
                  <span class="metadata-pill">UPC · TelecomBCN</span>
                  <span class="metadata-pill">2005–2008</span>
                  <span class="metadata-pill">Barcelona</span>
                </p>
              </div>
              <p>
                Focused on telecommunications systems, networking and signal processing.
              </p>
            </div>
            <div class="education-item">
              <div class="item-heading">
                <h3>BSc Telecommunications Engineering</h3>
                <p>
                  <span class="metadata-pill">UPC</span>
                  <span class="metadata-pill">2001–2005</span>
                  <span class="metadata-pill">Barcelona</span>
                </p>
              </div>
              <p>
                Built the engineering foundations in mathematics, electronics and
                telecommunications.
              </p>
            </div>
          </div>
        </div>
      </section>

      <section class="about-section compact" data-motion-reveal>
        <div class="section-label">
          <h2>Languages</h2>
        </div>
        <div class="section-body">
          <ChipList items={languages} label="Languages" />
        </div>
      </section>

      <section class="about-section compact" data-motion-reveal>
        <div class="section-label">
          <h2>Current interests</h2>
        </div>
        <div class="section-body">
          <ChipList items={interests} label="Current interests" />
        </div>
      </section>

      <section class="about-section" data-motion-reveal>
        <div class="section-label">
          <h2>Building as a way of thinking</h2>
        </div>
        <div class="section-body">
          <div class="reading-flow">
            <p>
              Outside my professional work, I build systems to explore architectural ideas
              without the constraints of a large enterprise environment.
            </p>
          </div>
          <article class="feature-card">
            <p class="eyebrow">AtlasDocs</p>
            <h3>{atlasDocs?.description ?? "Document intelligence and knowledge architecture."}</h3>
            <p>{atlasDocs?.summary}</p>
            <a class="button-link" href="/projects/atlasdocs/">View AtlasDocs</a>
          </article>
        </div>
      </section>

      <section class="about-section compact" data-motion-reveal>
        <div class="section-label">
          <h2>Writing</h2>
        </div>
        <div class="section-body reading-flow">
          <p>
            I use technical writing to make architectural decisions explicit: why a particular
            approach works, when it does not, and what trade-offs sit behind it.
          </p>
          <p>
            <a class="button-link" href="/writing/">Explore writing</a>
          </p>
        </div>
      </section>
    </div>
  </section>
</BaseLayout>

<style>
  .about-page {
    display: grid;
    gap: var(--space-8);
  }

  .about-page .page-hero {
    gap: var(--space-6);
  }

  .about-hero-title {
    display: grid;
    gap: var(--space-4);
  }

  .about-hero-body {
    display: grid;
    grid-template-columns: minmax(12rem, 0.32fr) minmax(0, 1fr);
    align-items: start;
    column-gap: var(--space-6);
    padding-top: var(--space-5);
    border-top: 1px solid var(--color-border);
  }

  .about-hero-content {
    grid-column: 2;
    display: grid;
    align-content: start;
    gap: var(--space-4);
  }

  .about-portrait {
    display: grid;
    gap: var(--space-3);
    margin: 0;
    max-width: 13.75rem;
  }

  .about-portrait img {
    display: block;
    width: 100%;
    aspect-ratio: 1;
    border: 1px solid var(--color-border);
    border-radius: calc(var(--radius-medium) + 4px);
    object-fit: cover;
  }

  .about-portrait figcaption {
    display: grid;
    gap: 0.15rem;
    color: var(--color-muted);
    font-size: 0.9rem;
    line-height: 1.35;
  }

  .about-portrait figcaption strong {
    color: var(--color-text);
    font-weight: 700;
  }

  .reading-flow,
  .section-intro {
    max-width: none;
    width: 100%;
  }

  .reading-flow {
    display: grid;
    gap: var(--space-4);
  }

  .reading-flow p,
  .section-intro,
  .timeline p,
  .education-list p,
  .feature-card > p:not(.eyebrow) {
    margin: 0;
    color: var(--color-muted);
    font-size: 1em;
    line-height: inherit;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .about-section {
    display: grid;
    grid-template-columns: minmax(12rem, 0.32fr) minmax(0, 1fr);
    gap: var(--space-6);
    padding-top: var(--space-7);
    border-top: 1px solid var(--color-border);
  }

  .about-section.compact {
    padding-top: var(--space-6);
  }

  .section-label h2 {
    position: sticky;
    top: 6rem;
    margin: 0;
    color: var(--color-accent-strong);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  @media (max-width: 760px) {
    .about-hero-body {
      grid-template-columns: 1fr;
      row-gap: var(--space-5);
    }

    .about-hero-content {
      grid-column: 1;
    }

    .about-portrait {
      width: min(10rem, 48vw);
    }
  }

  .section-body {
    display: grid;
    gap: var(--space-5);
  }

  .hero-subsection {
    display: grid;
    gap: var(--space-3);
    margin-top: 1.25rem;
  }

  .hero-subsection h2 {
    margin: 0;
    color: var(--color-accent-strong);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .principle-flow {
    display: grid;
    gap: var(--space-3);
    max-width: none;
    width: 100%;
    margin: var(--space-2) 0 0;
    padding: 0;
    list-style: none;
  }

  .principle-flow li {
    position: relative;
    padding: var(--space-4) var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
    color: var(--color-text);
    font-weight: 700;
  }

  .principle-flow li:not(:last-child)::after {
    content: "";
    position: absolute;
    left: var(--space-5);
    bottom: -0.8rem;
    width: 1px;
    height: 0.8rem;
    background: var(--color-accent);
  }

  .hero-principles {
    margin-top: 0;
  }

  .timeline {
    display: grid;
    gap: var(--space-6);
    max-width: none;
    width: 100%;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .timeline li {
    display: grid;
    gap: var(--space-4);
    padding-left: var(--space-5);
    border-left: 1px solid var(--color-border);
  }

  .experience-heading,
  .item-heading {
    display: grid;
    gap: var(--space-2);
  }

  .experience-heading h3,
  .item-heading h3 {
    margin: 0;
    color: var(--color-text);
    font-size: 1.12em;
    line-height: 1.3;
  }

  .experience-heading p,
  .item-heading p {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: var(--space-3);
    margin: 0;
    text-align: left;
  }

  .experience-heading .metadata-pill,
  .item-heading .metadata-pill {
    width: fit-content;
    padding: 0.2rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--color-warm-accent) 42%, var(--color-border));
    border-radius: 999px;
    color: var(--color-warm-accent);
    font-size: 0.8rem;
    font-weight: 650;
    line-height: 1.2;
  }

  .education-list {
    display: grid;
    gap: var(--space-5);
    max-width: none;
    width: 100%;
  }

  .education-item {
    display: grid;
    gap: var(--space-4);
    padding-left: var(--space-5);
    border-left: 1px solid var(--color-border);
  }

  .education-item:last-child {
    padding-bottom: 0;
  }

  .feature-card {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: color-mix(in srgb, var(--color-surface) 86%, transparent);
  }

  .feature-card h3 {
    margin: 0 0 var(--space-2);
    font-size: 1.12rem;
    line-height: 1.3;
  }

  .feature-card {
    display: grid;
    gap: var(--space-3);
    max-width: none;
    width: 100%;
  }

  .feature-card .eyebrow {
    margin: 0;
  }

  @media (max-width: 820px) {
    .about-section {
      grid-template-columns: 1fr;
      gap: var(--space-4);
    }

    .section-label h2 {
      position: static;
    }
  }
</style>
