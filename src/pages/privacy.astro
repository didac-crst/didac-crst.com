---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/site.config";
---

<BaseLayout
  title="Privacy"
  description="How personal information is handled on didac-crst.com, including hosting, infrastructure providers, and external links."
>
  <section class="section">
    <div class="reading-container stack policy-page">
      <header class="page-hero" data-motion-enter>
        <p class="eyebrow">Privacy</p>
        <h1 class="page-title">Privacy</h1>
        <p class="lede">
          This website is designed to collect as little personal information as possible.
        </p>
      </header>

      <div class="reading-flow" data-motion-reveal>
        <h2>Personal data</h2>
        <p>
          This website does not require user accounts or registrations. If you contact me by
          email, the information you provide is used only to reply.
        </p>

        <h2>Analytics</h2>
        <p>
          This website does not currently use analytics or tracking cookies. If analytics are
          added in the future, this page will be updated.
        </p>

        <h2>Hosting</h2>
        <p>
          The website is hosted using GitHub Pages and protected by Cloudflare. These
          infrastructure providers necessarily process technical information (such as IP
          addresses, request metadata, and TLS information) to deliver the website securely.
        </p>

        <h2>External links</h2>
        <p>
          Links to external websites (including GitHub and LinkedIn) are governed by their
          own privacy policies.
        </p>

        <h2>Contact</h2>
        <p>
          <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .policy-page {
    display: grid;
    gap: var(--space-6);
  }

  .page-title {
    max-width: none;
  }

  .reading-flow {
    display: grid;
    gap: var(--space-4);
    max-width: var(--width-reading);
  }

  .reading-flow h2 {
    margin: var(--space-3) 0 0;
    font-size: 1.25rem;
    line-height: 1.25;
  }

  .reading-flow p {
    margin: 0;
    color: var(--color-muted);
    font-size: 1.05rem;
    line-height: 1.75;
  }
</style>
