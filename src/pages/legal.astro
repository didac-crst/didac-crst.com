---
import BaseLayout from "@/layouts/BaseLayout.astro";
import { SITE } from "@/site.config";
---

<BaseLayout
  title="Legal"
  description="Legal information for didac-crst.com, including copyright, hosting, intellectual property, liability, and publisher details."
>
  <section class="section">
    <div class="page-container stack policy-page">
      <header class="page-hero" data-motion-enter>
        <p class="eyebrow">Legal</p>
        <h1 class="page-title">Legal</h1>
      </header>

      <div class="reading-flow" data-motion-reveal>
        <h2>Publisher</h2>
        <p>
          {SITE.name}<br />
          Personal website about software architecture, knowledge engineering, and AI-enhanced
          systems.
        </p>
        <p>
          Contact: <a href={`mailto:${SITE.email}`}>{SITE.email}</a>
        </p>

        <h2>Hosting</h2>
        <p>
          Hosted on GitHub Pages.<br />
          Protected and delivered through Cloudflare.
        </p>

        <h2>Intellectual property</h2>
        <p>Unless otherwise stated:</p>
        <ul>
          <li>Articles are © {SITE.name}.</li>
          <li>Source code remains under the license defined in each individual repository.</li>
          <li>Third-party trademarks belong to their respective owners.</li>
        </ul>

        <h2>Liability</h2>
        <p>
          Content is provided for informational purposes. Although every effort is made to keep
          technical content accurate, no guarantee is made that articles remain complete or up
          to date. Readers remain responsible for validating information before using it in
          production environments.
        </p>

        <h2>Employer disclaimer</h2>
        <p>
          This website reflects my personal work and opinions and does not represent the views
          of my current or former employers.
        </p>

        <p class="updated">Last updated: 2026-08-16</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .policy-page {
    display: grid;
    gap: var(--space-6);
  }

  .page-title {
    max-width: none;
  }

  .reading-flow {
    display: grid;
    gap: var(--space-4);
    max-width: none;
    width: 100%;
  }

  .reading-flow h2 {
    margin: var(--space-3) 0 0;
    font-size: 1.2em;
    line-height: 1.25;
    text-align: left;
  }

  .reading-flow p,
  .reading-flow li {
    margin: 0;
    color: var(--color-muted);
    font-size: 1em;
    line-height: inherit;
    text-align: justify;
    text-justify: inter-word;
    hyphens: auto;
    -webkit-hyphens: auto;
  }

  .reading-flow ul {
    margin: 0;
    padding-left: 1.25rem;
    display: grid;
    gap: var(--space-2);
  }

  .updated {
    margin-top: var(--space-3);
    font-size: 0.92em;
  }
</style>
