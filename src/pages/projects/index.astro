---
import ProjectCard from "@/components/ProjectCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/projects";
import { SITE } from "@/site.config";
---

<BaseLayout
  title="Projects"
  description={`Public project notes and open-source work by ${SITE.fullName}.`}
>
  <section class="section">
    <div class="page-container stack">
      <div class="page-hero">
        <p class="eyebrow">Projects</p>
        <h1 class="page-title">Public systems and project documentation.</h1>
        <p class="lede">
          The project section starts small and will expand as work becomes ready to
          document publicly.
        </p>
      </div>
      <div class={`card-grid ${projects.length === 1 ? "single" : ""}`}>
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</BaseLayout>
