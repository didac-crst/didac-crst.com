---
import ProjectCard from "@/components/ProjectCard.astro";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { projects } from "@/projects";
import { SITE } from "@/site.config";
---

<BaseLayout
  title="Projects"
  description={`Public project notes and open-source work by ${SITE.fullName}.`}
>
  <section class="section">
    <div class="page-container stack">
      <div class="page-hero" data-motion-enter>
        <p class="eyebrow">Projects</p>
        <h1 class="page-title">Building systems in public.</h1>
        <p class="lede">
          Open engineering projects, architectural experiments, and systems documented
          as they evolve.
        </p>
      </div>
      <div class={`card-grid ${projects.length === 1 ? "single" : ""}`} data-motion-reveal>
        {projects.map((project) => <ProjectCard project={project} />)}
      </div>
    </div>
  </section>
</BaseLayout>
