---
import ThemeToggle from "./ThemeToggle.astro";
import { NAVIGATION, SITE } from "@/site.config";

const currentPath = Astro.url.pathname;
---

<header class="site-header">
  <div class="page-container header-inner">
    <a class="brand" href="/" aria-label={`${SITE.name} home`}>
      <img class="brand-mark" src={SITE.logo} alt="" width="40" height="40" aria-hidden="true" />
      <span>{SITE.name}</span>
    </a>
    <nav class="primary-nav" aria-label="Primary navigation">
      {
        NAVIGATION.map((item) => (
          <a
            href={item.href}
            aria-current={currentPath === item.href ? "page" : undefined}
          >
            {item.label}
          </a>
        ))
      }
    </nav>
    <div class="header-utility">
      <ThemeToggle />
    </div>
    <button
      class="mobile-menu-trigger"
      type="button"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="mobile-menu"
      data-mobile-menu-trigger
    >
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
    <div class="mobile-menu" id="mobile-menu" hidden data-mobile-menu>
      <nav class="mobile-nav" aria-label="Mobile navigation">
        {
          NAVIGATION.map((item) => (
            <a
              href={item.href}
              aria-current={currentPath === item.href ? "page" : undefined}
            >
              {item.label}
            </a>
          ))
        }
      </nav>
      <div class="mobile-theme">
        <span>Theme</span>
        <ThemeToggle />
      </div>
    </div>
  </div>
</header>

<style>
  .site-header {
    position: fixed;
    top: 0;
    right: 0;
    left: 0;
    z-index: 100;
    border-bottom: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
    background: color-mix(in srgb, var(--color-background) 82%, transparent);
    backdrop-filter: blur(6px) saturate(96%);
    -webkit-backdrop-filter: blur(6px) saturate(96%);
    transition:
      background-color var(--motion-fast) var(--ease-standard),
      border-color var(--motion-fast) var(--ease-standard);
  }

  :global(.site-shell) {
    padding-top: 4.25rem;
  }

  .header-inner {
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    align-items: center;
    gap: clamp(var(--space-4), 4vw, var(--space-7));
    min-height: 4.25rem;
    min-width: 0;
    transition: min-height var(--motion-fast) var(--ease-standard);
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    min-width: 0;
    color: var(--color-text);
    font-weight: 760;
    text-decoration: none;
    white-space: nowrap;
    justify-self: start;
  }

  .brand span {
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .brand-mark {
    width: 2.5rem;
    height: 2.5rem;
    flex: 0 0 auto;
    border-radius: var(--radius-small);
    object-fit: contain;
  }

  .primary-nav,
  .header-utility {
    display: flex;
    align-items: center;
    min-width: 0;
  }

  .header-utility {
    justify-content: end;
    justify-self: end;
  }

  .primary-nav {
    justify-content: center;
    justify-self: center;
    gap: var(--space-4);
    max-width: 100%;
    min-width: 0;
  }

  .primary-nav a {
    position: relative;
    color: var(--color-muted);
    font-size: 0.92rem;
    font-weight: 680;
    text-decoration: none;
    white-space: nowrap;
    transition: color var(--motion-fast) var(--ease-standard);
  }

  .primary-nav a::after {
    content: "";
    position: absolute;
    left: 0;
    right: 0;
    bottom: -0.38rem;
    height: 1px;
    background: currentColor;
    opacity: 0;
    transform: scaleX(0.45);
    transition:
      opacity var(--motion-fast) var(--ease-standard),
      transform var(--motion-fast) var(--ease-standard);
    transform-origin: center;
  }

  .primary-nav a:hover,
  .primary-nav a[aria-current="page"] {
    color: var(--color-text);
  }

  .primary-nav a:hover::after,
  .primary-nav a[aria-current="page"]::after {
    opacity: 1;
    transform: scaleX(1);
  }

  .mobile-menu-trigger,
  .mobile-menu {
    display: none;
  }

  .mobile-menu-trigger {
    width: 2.5rem;
    height: 2.5rem;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 0.28rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
    border-radius: var(--radius-small);
    background: transparent;
    color: var(--color-text);
    cursor: pointer;
    justify-self: end;
  }

  .mobile-menu-trigger span {
    width: 1rem;
    height: 1px;
    background: currentColor;
    transition:
      transform var(--motion-fast) var(--ease-standard),
      opacity var(--motion-fast) var(--ease-standard);
  }

  .mobile-menu-trigger[aria-expanded="true"] span:nth-child(1) {
    transform: translateY(0.29rem) rotate(45deg);
  }

  .mobile-menu-trigger[aria-expanded="true"] span:nth-child(2) {
    opacity: 0;
  }

  .mobile-menu-trigger[aria-expanded="true"] span:nth-child(3) {
    transform: translateY(-0.29rem) rotate(-45deg);
  }

  .mobile-menu {
    grid-column: 1 / -1;
    position: relative;
    z-index: 210;
    min-width: 0;
    max-width: 100%;
    padding: var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
    box-shadow: var(--shadow-subtle);
  }

  .mobile-nav {
    display: grid;
    min-width: 0;
    gap: var(--space-1);
  }

  .mobile-nav a {
    padding: 0.62rem 0.7rem;
    border-radius: var(--radius-small);
    color: var(--color-muted);
    font-weight: 700;
    text-decoration: none;
    min-width: 0;
  }

  .mobile-nav a:hover,
  .mobile-nav a[aria-current="page"] {
    background: var(--color-surface-muted);
    color: var(--color-text);
  }

  .mobile-theme {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding: var(--space-3) 0.7rem 0;
    border-top: 1px solid var(--color-border);
    color: var(--color-muted);
    font-size: 0.84rem;
    font-weight: 700;
  }

  @media (max-width: 860px) {
    .header-inner {
      gap: var(--space-4);
    }
  }

  @media (max-width: 760px) {
    :global(.site-shell) {
      padding-top: 3.75rem;
    }

    .header-inner {
      grid-template-columns: 1fr auto;
      min-height: 3.75rem;
      padding-block: var(--space-2);
    }

    .primary-nav,
    .header-utility {
      display: none;
    }

    .mobile-menu-trigger {
      display: inline-flex;
    }

    .mobile-menu:not([hidden]) {
      display: block;
    }

  }

  @media (max-width: 420px) {
    .brand {
      gap: 0.55rem;
      font-size: 0.95rem;
    }

    .brand-mark {
      width: 2.25rem;
      height: 2.25rem;
    }

    .mobile-menu-trigger {
      width: 2.35rem;
      height: 2.35rem;
    }
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .site-header {
      background: color-mix(in srgb, var(--color-background) 78%, transparent);
    }
  }

  :global(:root[data-theme="dark"]) .site-header {
    background: color-mix(in srgb, var(--color-background) 78%, transparent);
  }
</style>
