<div class="theme-control" data-theme-control>
  <button
    class="theme-trigger"
    type="button"
    aria-label="Theme"
    aria-haspopup="menu"
    aria-expanded="false"
    data-theme-trigger
  >
    <svg class="theme-icon theme-icon-system" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M4 5.5A2.5 2.5 0 0 1 6.5 3h11A2.5 2.5 0 0 1 20 5.5v7a2.5 2.5 0 0 1-2.5 2.5h-11A2.5 2.5 0 0 1 4 12.5v-7Z" />
      <path d="M9 21h6M12 15v6" />
    </svg>
    <svg class="theme-icon theme-icon-light" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M12 4V2M12 22v-2M4.93 4.93 3.52 3.52M20.48 20.48l-1.41-1.41M4 12H2M22 12h-2M4.93 19.07l-1.41 1.41M20.48 3.52l-1.41 1.41" />
      <circle cx="12" cy="12" r="4" />
    </svg>
    <svg class="theme-icon theme-icon-dark" viewBox="0 0 24 24" aria-hidden="true">
      <path d="M20 15.2A8.5 8.5 0 0 1 8.8 4a7.2 7.2 0 1 0 11.2 11.2Z" />
    </svg>
    <span data-theme-label>System</span>
  </button>
  <div class="theme-menu" role="menu" aria-label="Choose theme" hidden data-theme-menu>
    <button type="button" role="menuitemradio" aria-checked="true" data-theme-choice="system">
      System
    </button>
    <button type="button" role="menuitemradio" aria-checked="false" data-theme-choice="light">
      Light
    </button>
    <button type="button" role="menuitemradio" aria-checked="false" data-theme-choice="dark">
      Dark
    </button>
  </div>
</div>

<script is:inline>
  const control = document.querySelector("[data-theme-control]");
  const trigger = control?.querySelector("[data-theme-trigger]");
  const menu = control?.querySelector("[data-theme-menu]");
  const label = control?.querySelector("[data-theme-label]");
  const buttons = Array.from(control?.querySelectorAll("[data-theme-choice]") || []);
  let isOpen = false;

  function setOpen(open) {
    if (!trigger || !menu) return;
    isOpen = open;
    trigger.setAttribute("aria-expanded", String(open));
    menu.hidden = !open;
  }

  function getCheckedButton() {
    return buttons.find((button) => button.getAttribute("aria-checked") === "true") || buttons[0];
  }

  function openMenu() {
    setOpen(true);
    getCheckedButton()?.focus();
  }

  function closeMenu(focusTrigger = false) {
    setOpen(false);
    if (focusTrigger) {
      trigger?.focus();
    }
  }

  function focusByOffset(offset) {
    const currentIndex = Math.max(0, buttons.indexOf(document.activeElement));
    const nextIndex = (currentIndex + offset + buttons.length) % buttons.length;
    buttons[nextIndex]?.focus();
  }

  function renderTheme(theme) {
    if (!control || !label) return;
    control.dataset.themePreference = theme;
    label.textContent = theme.charAt(0).toUpperCase() + theme.slice(1);
    trigger?.setAttribute("aria-label", `Theme: ${label.textContent}`);

    buttons.forEach((button) => {
      button.setAttribute("aria-checked", button.dataset.themeChoice === theme ? "true" : "false");
    });
  }

  renderTheme(window.DidacTheme?.getPreference?.() || "system");

  trigger?.addEventListener("click", () => {
    if (isOpen) {
      closeMenu();
    } else {
      openMenu();
    }
  });

  buttons.forEach((button) => {
    button.addEventListener("click", () => {
      const theme = button.dataset.themeChoice || "system";
      window.DidacTheme?.setPreference?.(theme);
      renderTheme(theme);
      closeMenu(true);
    });

    button.addEventListener("keydown", (event) => {
      if (event.key === "ArrowDown") {
        event.preventDefault();
        focusByOffset(1);
      }

      if (event.key === "ArrowUp") {
        event.preventDefault();
        focusByOffset(-1);
      }

      if (event.key === "Home") {
        event.preventDefault();
        buttons[0]?.focus();
      }

      if (event.key === "End") {
        event.preventDefault();
        buttons[buttons.length - 1]?.focus();
      }
    });
  });

  window.addEventListener("didac-theme-change", (event) => {
    renderTheme(event.detail.preference);
  });

  document.addEventListener("click", (event) => {
    if (!control?.contains(event.target)) {
      closeMenu();
    }
  });

  document.addEventListener("keydown", (event) => {
    if (event.key === "Escape" && isOpen) {
      event.preventDefault();
      closeMenu(true);
    }
  });
</script>

<style>
  .theme-control {
    position: relative;
  }

  .theme-trigger {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    min-height: 2.25rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid color-mix(in srgb, var(--color-border) 72%, transparent);
    border-radius: var(--radius-small);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    font-size: 0.78rem;
    font-weight: 650;
  }

  .theme-trigger:hover,
  .theme-trigger[aria-expanded="true"] {
    border-color: color-mix(in srgb, var(--color-accent) 38%, var(--color-border));
    color: var(--color-text);
  }

  .theme-icon {
    display: none;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.8;
  }

  .theme-control[data-theme-preference="system"] .theme-icon-system,
  .theme-control[data-theme-preference="light"] .theme-icon-light,
  .theme-control[data-theme-preference="dark"] .theme-icon-dark {
    display: block;
  }

  .theme-menu {
    position: absolute;
    top: calc(100% + var(--space-2));
    right: 0;
    z-index: 20;
    min-width: 9rem;
    padding: var(--space-2);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: var(--color-surface);
    box-shadow: var(--shadow-subtle);
  }

  .theme-menu button {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: 100%;
    min-height: 2.1rem;
    padding: 0.35rem 0.55rem;
    border: 0;
    border-radius: var(--radius-small);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    font-size: 0.88rem;
    text-align: left;
  }

  .theme-menu button:hover,
  .theme-menu button[aria-checked="true"] {
    background: var(--color-surface-muted);
    color: var(--color-text);
  }

  .theme-menu button[aria-checked="true"]::after {
    content: "";
    width: 0.4rem;
    height: 0.4rem;
    border-radius: 999px;
    background: var(--color-accent);
  }

  @media (max-width: 640px) {
    .theme-trigger span {
      display: none;
    }

    .theme-trigger {
      width: 2.25rem;
      justify-content: center;
    }
  }
</style>
