---
import type { CollectionEntry } from "astro:content";
import ChipList from "./ChipList.astro";
import { getArticleSlug } from "@/lib/articles";

type Props = {
  article: CollectionEntry<"writing">;
  /** Optional status pill next to the date (e.g. homepage “Latest”) */
  badge?: string;
};

const { article, badge } = Astro.props;
const { title, description, published, tags } = article.data;
const slug = getArticleSlug(article);
---

<a class="card article-card" href={`/writing/${slug}/`}>
  <div class="meta">
    <time datetime={published.toISOString()}>
      {published.toLocaleDateString("en", {
        year: "numeric",
        month: "short",
        day: "numeric"
      })}
    </time>
    {badge && <span class="status-badge">{badge}</span>}
  </div>
  <h3>{title}</h3>
  <p>{description}</p>
  {
    tags.length > 0 && (
      <ChipList items={tags.slice(0, 3)} label="Tags" />
    )
  }
</a>
