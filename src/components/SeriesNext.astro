---
type Props = {
  title: string;
  description: string;
  href?: string;
};

const { title, description, href } = Astro.props;
---

<aside class="series-next" aria-label="Next in this series">
  <p class="series-next-label">Next in this series</p>
  {
    href ? (
      <a class="series-next-title" href={href}>{title}</a>
    ) : (
      <p class="series-next-title">{title}</p>
    )
  }
  <p class="series-next-blurb">{description}</p>
</aside>

<style>
  .series-next {
    margin-top: var(--space-7);
    margin-bottom: var(--space-2);
    padding-block: var(--space-6) var(--space-7);
    border-top: 1px solid var(--color-border);
    max-width: none;
    text-align: left;
    font-size: var(--article-font-size);
    line-height: var(--article-line-height);
  }

  .series-next-label {
    margin: 0 0 var(--space-2);
    color: var(--color-accent-strong);
    letter-spacing: 0.08em;
    text-transform: uppercase;
    font-size: var(--title-accent-size);
    font-weight: 700;
  }

  .series-next-title {
    margin: 0;
    color: var(--color-text);
    font-size: 1.15rem;
    font-weight: 700;
    line-height: 1.3;
    text-decoration: none;
  }

  a.series-next-title:hover {
    color: var(--color-accent-strong);
  }

  .series-next-blurb {
    margin: var(--space-2) 0 0;
    max-width: 40rem;
    color: var(--color-muted);
    font-size: 0.98rem;
    line-height: 1.55;
  }
</style>
