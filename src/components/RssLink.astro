---
import { SITE } from "@/site.config";

type Props = {
  /** Visible label next to the glyph */
  label?: string;
  class?: string;
};

const { label = "RSS", class: className } = Astro.props;
const feedUrl = new URL("/rss.xml", SITE.domain).toString();
---

<a
  class:list={["rss-link", className]}
  href="/rss.xml"
  type="application/rss+xml"
  data-rss-copy={feedUrl}
  title="Copy feed URL — paste into NetNewsWire, Feedly, or another reader"
>
  <svg viewBox="0 0 24 24" aria-hidden="true">
    <path
      d="M6.18 15.64a2.18 2.18 0 1 1-2.18 2.18 2.18 2.18 0 0 1 2.18-2.18ZM4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27Zm0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93Z"
    ></path>
  </svg>
  <span data-rss-label>{label}</span>
</a>

<script is:inline>
  (() => {
    if (window.DidacRssCopy) {
      window.DidacRssCopy.init();
      return;
    }

    const init = () => {
      document.querySelectorAll("[data-rss-copy]:not([data-rss-bound])").forEach((link) => {
        link.setAttribute("data-rss-bound", "true");
        link.addEventListener("click", async (event) => {
          const url = link.getAttribute("data-rss-copy") || "";
          if (!url || !navigator.clipboard?.writeText) {
            return;
          }

          event.preventDefault();

          try {
            await navigator.clipboard.writeText(url);
          } catch {
            window.location.href = link.getAttribute("href") || url;
            return;
          }

          const label = link.querySelector("[data-rss-label]");
          if (!label) return;

          const original = label.textContent;
          label.textContent = "Copied";
          window.setTimeout(() => {
            label.textContent = original;
          }, 1600);
        });
      });
    };

    window.DidacRssCopy = { init };
    document.addEventListener("astro:page-load", init);
    init();
  })();
</script>

<style>
  .rss-link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    color: var(--color-muted);
    font-weight: inherit;
    text-decoration: none;
  }

  .rss-link svg {
    width: 0.95rem;
    height: 0.95rem;
    fill: currentColor;
    flex: 0 0 auto;
  }

  .rss-link:hover {
    color: var(--color-accent-strong);
  }
</style>
