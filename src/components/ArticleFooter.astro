---
import ArticleCard from "./ArticleCard.astro";
import type { CollectionEntry } from "astro:content";
import { getArticleSlug } from "@/lib/articles";
import { SITE } from "@/site.config";

type Props = {
  article: CollectionEntry<"writing">;
  relatedArticles?: CollectionEntry<"writing">[];
};

const { article, relatedArticles = [] } = Astro.props;
const { title, published, updated, discussionUrl, sourceUrl, resources, versionHistory } = article.data;
const articleSlug = getArticleSlug(article);
const articleUrl = new URL(`/writing/${articleSlug}/`, SITE.domain).toString();
const encodedUrl = encodeURIComponent(articleUrl);
const encodedTitle = encodeURIComponent(title);
const markdownCitation = `${SITE.name}. "${title}." ${articleUrl}`;
const apaCitation = `${SITE.name}. (${published.getFullYear()}). ${title}. ${SITE.title}. ${articleUrl}`;
const bibtexKey = `cristobal${published.getFullYear()}${articleSlug.replace(/[^a-z0-9]/gi, "")}`;
const bibtexCitation = `@misc{${bibtexKey},
  author = {${SITE.name}},
  title = {${title}},
  year = {${published.getFullYear()}},
  url = {${articleUrl}},
  note = {Updated ${updated?.toISOString().slice(0, 10) ?? published.toISOString().slice(0, 10)}}
}`;
---

<footer class="article-footer reading-container">
  <section class="article-tools" aria-labelledby="share-title">
    <div>
      <h2 id="share-title">Share</h2>
      <div class="tool-row">
        <button type="button" data-copy-value={articleUrl}>Copy Link</button>
        <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodedUrl}`} rel="noopener noreferrer" target="_blank">LinkedIn</a>
        <a href={`https://twitter.com/intent/tweet?url=${encodedUrl}&text=${encodedTitle}`} rel="noopener noreferrer" target="_blank">X</a>
        <a href={`https://www.reddit.com/submit?url=${encodedUrl}&title=${encodedTitle}`} rel="noopener noreferrer" target="_blank">Reddit</a>
      </div>
    </div>

    <div>
      <h2>Citation</h2>
      <div class="tool-row">
        <button type="button" data-copy-value={markdownCitation}>Markdown</button>
        <button type="button" data-copy-value={apaCitation}>APA</button>
        <button type="button" data-copy-value={bibtexCitation}>BibTeX</button>
      </div>
    </div>
  </section>

  {
    discussionUrl && (
      <section class="article-panel">
        <h2>Discuss on GitHub</h2>
        <p>Found a mistake or want to challenge the argument?</p>
        <a href={discussionUrl} rel="noopener noreferrer" target="_blank">Open discussion</a>
      </section>
    )
  }

  {
    (sourceUrl || resources?.length) && (
      <section class="article-panel">
        <h2>Resources</h2>
        <ul>
          {sourceUrl && (
            <li>
              <a href={sourceUrl} rel="noopener noreferrer" target="_blank">Article source</a>
            </li>
          )}
          {resources?.map((resource) => (
            <li>
              <a href={resource.url} rel="noopener noreferrer" target="_blank">{resource.label}</a>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    versionHistory?.length && (
      <section class="article-panel">
        <h2>Version History</h2>
        <ol class="version-list">
          {versionHistory.map((entry) => (
            <li>
              <strong>{entry.version}</strong>
              <time datetime={entry.date.toISOString()}>
                {entry.date.toLocaleDateString("en", {
                  year: "numeric",
                  month: "long",
                  day: "numeric"
                })}
              </time>
              <p>{entry.notes}</p>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    relatedArticles.length > 0 && (
      <section class="related-articles">
        <h2>Continue Reading</h2>
        <div class="grid">
          {relatedArticles.map((related) => <ArticleCard article={related} />)}
        </div>
      </section>
    )
  }
</footer>

<script is:inline>
  document.querySelectorAll("[data-copy-value]").forEach((button) => {
    button.addEventListener("click", async () => {
      const value = button.getAttribute("data-copy-value") || "";
      await navigator.clipboard.writeText(value);
      const original = button.textContent;
      button.textContent = "Copied";
      window.setTimeout(() => {
        button.textContent = original;
      }, 1400);
    });
  });
</script>

<style>
  .article-footer {
    display: grid;
    gap: var(--space-5);
    padding-block: 0 var(--space-8);
  }

  .article-tools {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-5);
    padding-top: var(--space-6);
    border-top: 1px solid var(--color-border);
  }

  .article-tools h2,
  .article-panel h2,
  .related-articles h2 {
    margin: 0 0 var(--space-3);
    font-size: 0.9rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .tool-row {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-2);
  }

  .tool-row a,
  .tool-row button,
  .article-panel a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 2.2rem;
    padding: 0.45rem 0.7rem;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-small);
    background: var(--color-surface);
    color: var(--color-text);
    cursor: pointer;
    font-size: 0.88rem;
    font-weight: 650;
    text-decoration: none;
  }

  .article-panel {
    padding: var(--space-5);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-medium);
    background: color-mix(in srgb, var(--color-surface) 82%, transparent);
  }

  .article-panel p {
    margin: 0 0 var(--space-3);
    color: var(--color-muted);
  }

  .article-panel ul,
  .version-list {
    margin: 0;
    padding-left: 1.2rem;
  }

  .version-list li + li {
    margin-top: var(--space-4);
  }

  .version-list time {
    display: block;
    color: var(--color-muted);
    font-size: 0.9rem;
  }

  .version-list p {
    margin-top: var(--space-1);
  }

  @media (max-width: 720px) {
    .article-tools {
      grid-template-columns: 1fr;
    }
  }
</style>
