---
import type { Project } from "@/projects";
import ChipList from "./ChipList.astro";

type Props = {
  project: Project;
  /** Optional status pill next to the date (e.g. homepage “Current”) */
  badge?: string;
};

const { project, badge } = Astro.props;
---

<a class="card project-card" href={`/projects/${project.slug}/`}>
  {
    project.image && (
      <img src={project.image.src} alt={project.image.alt} loading="lazy" decoding="async" />
    )
  }
  <div class="meta">
    <time datetime={project.updated.toISOString()}>
      Updated{" "}
      {project.updated.toLocaleDateString("en", {
        year: "numeric",
        month: "short",
        day: "numeric"
      })}
    </time>
    {badge && <span class="status-badge">{badge}</span>}
  </div>
  <h3>{project.name}</h3>
  <p>{project.description}</p>
  {
    project.tags.length > 0 && (
      <ChipList items={project.tags.slice(0, 3)} label="Tags" />
    )
  }
</a>
