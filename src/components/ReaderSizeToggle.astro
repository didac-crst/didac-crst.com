  }

  .reader-menu button {
    display: grid;
    justify-items: center;
    gap: 0.15rem;
    min-height: 2.6rem;
    padding: 0.35rem 0.25rem;
    border: 0;
    border-radius: var(--radius-small);
    background: transparent;
    color: var(--color-muted);
    cursor: pointer;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.04em;
  }

  .reader-choice-mark {
    color: inherit;
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .reader-menu button:hover,
  .reader-menu button[aria-checked="true"] {
