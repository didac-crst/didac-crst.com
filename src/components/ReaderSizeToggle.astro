<div class="reader-control" data-reader-control>
  <button
    class="reader-trigger"
    type="button"
    aria-label="Text size"
    aria-haspopup="menu"
    aria-expanded="false"
    data-reader-trigger
  >
    <span class="reader-mark" aria-hidden="true">Aa</span>
    <span class="reader-label" data-reader-label>S</span>
  </button>
  <div class="reader-menu" role="menu" aria-label="Choose reading text size" hidden data-reader-menu>
    <button type="button" role="menuitemradio" aria-checked="false" data-reader-choice="xs">
      <span class="reader-choice-mark" style="font-size: 0.82rem">Aa</span>
      <span>XS</span>
    </button>
    <button type="button" role="menuitemradio" aria-checked="true" data-reader-choice="s">
      <span class="reader-choice-mark" style="font-size: 0.95rem">Aa</span>
      <span>S</span>
    </button>
    <button type="button" role="menuitemradio" aria-checked="false" data-reader-choice="m">
      <span class="reader-choice-mark" style="font-size: 1.08rem">Aa</span>
      <span>M</span>
    </button>
    <button type="button" role="menuitemradio" aria-checked="false" data-reader-choice="l">
      <span class="reader-choice-mark" style="font-size: 1.2rem">Aa</span>
      <span>L</span>
    </button>
    <button type="button" role="menuitemradio" aria-checked="false" data-reader-choice="xl">
      <span class="reader-choice-mark" style="font-size: 1.32rem">Aa</span>
      <span>XL</span>
    </button>
  </div>
</div>

<style>
